{
  "name": "beergogglegames-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=18.20.8 <19 || >=20"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "typecheck": "astro check",
    "sync": "astro sync",
    "predev": "astro sync",
    "prebuild": "astro sync",
    "postinstall": "astro sync",
    "format": "prettier --write .",
    "build": "astro build",
    "preview": "astro preview",
    "content:normalize": "node scripts/normalize-content.mjs --verbose",
    "content:check": "node scripts/check-deprecated-paths.mjs",
    "content:fix": "npm run content:normalize && npm run content:check",
    "maintenance": "npm run content:fix",
    "ci": "npm run sync && npm run typecheck && npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky install",
    "health": "npm run sync && npm run typecheck && npm run maintenance && npm run build"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.10",
    "@astrojs/sitemap": "^3.6.0",
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^5.15.5",
    "cheerio": "^1.1.2",
    "turndown": "^7.2.2",
    "zod": "^3.23.8",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "autoprefixer": "^10.4.20",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "eslint": "^9.12.0",
    "eslint-plugin-astro": "^1.2.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "postcss": "^8.4.45",
    "prettier": "^3.3.3",
    "prettier-plugin-astro": "^0.14.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.18"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.astro": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,mdx,html,json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
