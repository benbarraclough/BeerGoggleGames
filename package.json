{
  "name": "beergogglegames-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=18.20.8 <19 || >=20"
  },
  "scripts": {
    "start": "astro dev",
    "dev": "astro dev",
    "check": "astro check",
    "typecheck": "astro check",
    "sync": "astro sync",
    "predev": "astro sync",
    "prebuild": "astro sync",
    "postinstall": "astro sync",
    "format": "prettier --write .",
    "build": "astro build",
    "preview": "astro preview",
    "content:normalize": "node scripts/normalize-content.mjs --verbose",
    "content:check": "node scripts/check-deprecated-paths.mjs",
    "content:fix": "npm run content:normalize && npm run content:check",
    "maintenance": "npm run content:fix",
    "ci": "npm run sync && npm run typecheck && npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "health": "npm run sync && npm run typecheck && npm run maintenance && npm run build",
    "self-test": "bash scripts/self-test.sh"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.10",
    "@astrojs/sitemap": "^3.6.0",
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^5.15.5",
    "cheerio": "^1.1.2",
    "gray-matter": "^4.0.3",
    "turndown": "^7.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@tailwindcss/typography": "^0.5.19",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.47.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.12.0",
    "eslint-plugin-astro": "^1.2.0",
    "postcss": "^8.4.45",
    "prettier": "^3.3.3",
    "prettier-plugin-astro": "^0.14.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3"
  }
}
