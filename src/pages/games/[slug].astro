---
import Layout from '../../components/Layout.astro';
import { getCollection } from 'astro:content';
import { canonical } from '../../lib/urls';
import { withBase } from '../../lib/paths';
import { playerModeLabel, playerModeSlug } from '../../lib/playerMode';

export async function getStaticPaths() {
  const entries = await getCollection('games');
  const leafMap = new Map<string, any>();
  const duplicates: string[] = [];
  for (const e of entries) {
    const leaf = (e.slug ?? e.id).split('/').pop()!;
    if (leafMap.has(leaf)) duplicates.push(leaf);
    else leafMap.set(leaf, e);
  }
  if (duplicates.length) throw new Error(`[games] Duplicate leaf slug(s): ${duplicates.join(', ')}`);
  return Array.from(leafMap.keys()).map(leaf => ({ params: { slug: leaf } }));
}

const leaf = Astro.params.slug;
const allEntries = await getCollection('games');
const leafMap = new Map<string, any>();
for (const e of allEntries) {
  const l = (e.slug ?? e.id).split('/').pop()!;
  if (!leafMap.has(l)) leafMap.set(l, e);
}
const entry = leafMap.get(leaf);
if (!entry) throw new Error(`Game not found for leaf "${leaf}"`);

const { Content } = await entry.render();

const title = entry.data.title;
const description = entry.data.excerpt || entry.data.description || `Drinking game: ${title}`;
const type = (entry.data.type || '').toString();
const rawMode = entry.data.format || entry.data.players;
const modeSlug = rawMode ? playerModeSlug(rawMode) : '';
const tags: string[] = Array.isArray(entry.data.tags) ? entry.data.tags : [];
const coverFile = entry.data.cover || `${leaf}.webp`;
const cover = withBase(`images/${coverFile}`);
const pageCanonical = canonical(Astro.url.pathname, Astro.site);

const jsonLd = { '@context': 'https://schema.org', '@type': 'CreativeWork', name: title, description, genre: type, keywords: [...tags, type, modeSlug].filter(Boolean).join(', ') };
---
<Layout title={title} description={description} canonical={pageCanonical} image={cover}>
  <article class="prose-invert max-w-none tone-cyan">
    <header class="mb-6">
      <h1 class="font-display text-4xl mb-2 tone-cyan-text">{title}</h1>
      {description && (
        <p class="text-lg text-muted mb-4 leading-relaxed max-w-prose">
          {description}
        </p>
      )}
      <div class="flex flex-wrap gap-2">
        {type && <span class="pill pill--soft" aria-label={`Type: ${type}`}>{type}</span>}
        {rawMode && <span class="pill pill--soft" aria-label={`Player mode: ${playerModeLabel(rawMode)}`}>{playerModeLabel(rawMode)}</span>}
        {tags.map(t => <span class="pill pill--soft" aria-label={`Tag: ${t}`}>{t}</span>)}
      </div>
    </header>

    <div class="divider" aria-hidden="true"></div>

    <Content />

    <p class="mt-10 text-xs text-muted">
      <a class="hover:text-fg underline underline-offset-4" href={withBase('games/')}>Back to Games Index</a>
    </p>
  </article>

  <!-- Add icons before section headings -->
  <script is:inline>
    (function(){
      const map = [
        { re: /(overview|about)/i, icon: '/images/info.webp' },
        { re: /(equipment|items|gear|glass)/i, icon: '/images/liquor.webp' },
        { re: /(setup|prepare|start)/i, icon: '/images/settings.webp' },
        { re: /(aim|goal|objective|target)/i, icon: '/images/target.webp' },
        { re: /(how to|play|steps|instructions|method|recipe)/i, icon: '/images/question.webp' },
        { re: /(rules?|guidelines|dos|donts)/i, icon: '/images/rules.webp' },
        { re: /(tips|advice|hints|notes)/i, icon: '/images/lightbulb.webp' },
        { re: /(special|variants|edition|extras?)/i, icon: '/images/special.webp' }
      ];
      function matchIcon(text){
        for (const m of map) if (m.re.test(text)) return m.icon;
        return null;
      }
      document.querySelectorAll('article h2, article h3').forEach(h => {
        if (h.querySelector('.section-icon')) return;
        const icon = matchIcon(h.textContent || '');
        if (!icon) return;
        const span = document.createElement('span');
  span.className = 'section-icon inline-flex w-9 h-9 items-center justify-center rounded-lg bg-fg/5 border border-fg/15 mr-2 align-middle';
        span.innerHTML = `<img src="${icon}" alt="" class="w-5 h-5 object-contain opacity-90" loading="lazy" />`;
        h.prepend(span);
      });
    })();
  </script>

  <script type="application/ld+json">
    {JSON.stringify(jsonLd, null, 2)}
  </script>
</Layout>
