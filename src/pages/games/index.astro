---
import Layout from '../../components/Layout.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import FeedbackCard from '../../components/FeedbackCard.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/paths';
import { canonical } from '../../lib/urls';
import { excludeLegacyNoise } from '../../lib/filters';
import { playerModeSlug, playerModeLabel } from '../../lib/playerMode';
import { pickImageFile } from '../../lib/images';

const raw = excludeLegacyNoise(await getCollection('games'));

const allGames = raw
  .map(g => {
    const full = g.slug ?? g.id;
    const leaf = (full.split('/').pop() || '') as string;
    const type = (g.data.type || 'misc').toString();
    const rawMode = g.data.format || g.data.players;
    const modeSlug = rawMode ? playerModeSlug(rawMode) : '';
    const tags = Array.isArray(g.data.tags) ? g.data.tags : [];
    const excerpt = (g.data.excerpt || '').toString();
    return {
      title: g.data.title,
      type,
      rawMode,
      modeSlug,
      tags,
      excerpt,
      leaf,
      image: withBase(`images/${pickImageFile(leaf)}`),
      href: withBase(`games/${leaf}/`),
    };
  })
  .sort((a, b) => (a.title || '').localeCompare(b.title || ''));

const categoryCounts = new Map<string, number>();
const modeCounts = new Map<string, { count: number; label: string }>();
const tagCounts = new Map<string, number>();
for (const g of allGames) {
  categoryCounts.set(g.type, (categoryCounts.get(g.type) || 0) + 1);
  if (g.modeSlug && g.rawMode) {
    const prev = modeCounts.get(g.modeSlug);
    if (prev) prev.count += 1;
    else modeCounts.set(g.modeSlug, { count: 1, label: playerModeLabel(g.rawMode) });
  }
  for (const t of g.tags) tagCounts.set(t, (tagCounts.get(t) || 0) + 1);
}
const categories = Array.from(categoryCounts.entries()).sort((a, b) => a[0].localeCompare(b[0]));
const modes = Array.from(modeCounts.entries()).sort((a, b) => a[1].label.localeCompare(b[1].label));
const tags = Array.from(tagCounts.entries()).sort((a, b) => a[0].localeCompare(b[0]));

const pageCanonical = canonical(Astro.url.pathname, Astro.site);
---

<Layout
  title="Games"
  description="All drinking games. Filter or search by category, player mode, or tags."
  canonical={pageCanonical}
  wide={true}
>
  <div class="tone-cyan">
    <h1 class="tone-cyan-text mb-4 font-display text-4xl">Games</h1>
    <p class="mb-5 text-sm text-muted">
      A complete collection of all games A–Z. Use search and filters, or pick a
      <a class="underline underline-offset-4 hover:text-fg" href={withBase('games/random')}
        >Random Game</a
      >
    </p>

    <div class="divider" aria-hidden="true"></div>

    <!-- Row 1: Search -->
    <div class="mb-4">
      <div class="flex items-end gap-2 md:mr-4">
        <label class="flex flex-col gap-1 text-xs font-medium tracking-wide text-muted">
          <span>Search</span>
          <input
            id="game-search"
            type="search"
            placeholder="Search games..."
            class="w-full rounded border border-fg/30 bg-fg/5 px-3 py-2 text-sm focus:outline-none focus:ring-2 md:w-96"
            autocomplete="off"
          />
        </label>
      </div>
    </div>

    <!-- Row 2: Filters -->
    <div class="mb-6">
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-[11px] uppercase tracking-wide text-muted/70">Filters</span>

        <div class="relative" data-filter-wrapper>
          <button
            type="button"
            class="filter-toggle pill pill--soft"
            data-panel="categories"
            data-filter-group="category"
            aria-expanded="false"
            aria-pressed="false"
          >
            Categories
          </button>
          <div
            class="filter-panel hidden"
            id="panel-categories"
            role="group"
            aria-label="Categories"
          >
            <div class="panel-inner">
              {
                categories.map(([cat, count]) => (
                  <button
                    type="button"
                    class="filter-item pill pill--soft"
                    data-filter-type="category"
                    data-value={cat}
                    aria-pressed="false"
                  >
                    <>
                      <span>{cat}</span>
                      <span class="count">{count}</span>
                    </>
                  </button>
                ))
              }
            </div>
          </div>
        </div>

        <div class="relative" data-filter-wrapper>
          <button
            type="button"
            class="filter-toggle pill pill--soft"
            data-panel="modes"
            data-filter-group="mode"
            aria-expanded="false"
            aria-pressed="false"
          >
            Player modes
          </button>
          <div class="filter-panel hidden" id="panel-modes" role="group" aria-label="Player modes">
            <div class="panel-inner">
              {
                modes.map(([slug, info]) => (
                  <button
                    type="button"
                    class="filter-item pill pill--soft"
                    data-filter-type="mode"
                    data-value={slug}
                    aria-pressed="false"
                  >
                    <>
                      <span>{info.label}</span>
                      <span class="count">{info.count}</span>
                    </>
                  </button>
                ))
              }
            </div>
          </div>
        </div>

        <div class="relative" data-filter-wrapper>
          <button
            type="button"
            class="filter-toggle pill pill--soft"
            data-panel="tags"
            data-filter-group="tag"
            aria-expanded="false"
            aria-pressed="false"
            id="tags-toggle"
          >
            Tags
          </button>
          <!-- Force solid background + high z-index inline to beat any bundle order -->
          <div
            class="filter-panel filter-panel--solid hidden"
            id="panel-tags"
            role="group"
            aria-label="Tags"
            style="
              z-index: 1200 !important;
              background: rgb(var(--bg-rgb)) !important;
              background-image: none !important;
              -webkit-backdrop-filter: none !important;
              backdrop-filter: none !important;
              filter: none !important;
              opacity: 1 !important;
              mix-blend-mode: normal !important;
              border: 1px solid rgba(255,255,255,0.18) !important;
              box-shadow: 0 10px 24px rgba(0,0,0,0.55) !important;
            "
          >
            <div class="panel-inner">
              {
                tags.map(([t, count]) => (
                  <button
                    type="button"
                    class="filter-item pill pill--soft"
                    data-filter-type="tag"
                    data-value={t}
                    aria-pressed="false"
                  >
                    <>
                      <span>{t}</span>
                      <span class="count">{count}</span>
                    </>
                  </button>
                ))
              }
            </div>
          </div>
        </div>

        <div class="mt-2 flex w-full items-center gap-3 sm:mt-0 sm:w-auto">
          <a href="#" id="exclusive-toggle" class="filter-link" aria-pressed="false">
            <span class="dot" aria-hidden="true"></span>
            Exclusive
          </a>
          <a href="#" id="clear-filters" class="filter-link text-muted" aria-disabled="true">
            Clear
          </a>
          <!-- Mobile-only result count on same row as the links -->
          <span id="result-count-mobile" class="ml-auto text-xs text-muted sm:hidden"></span>
        </div>

        <!-- Desktop/tablet result count on far right -->
        <span id="result-count" class="ml-auto hidden text-xs text-muted sm:inline"></span>
      </div>
    </div>

    {
      allGames.length === 0 ? (
        <p class="text-muted">No games found.</p>
      ) : (
        <ul
          id="game-grid"
          class="m-0 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-3 2xl:grid-cols-3"
        >
          {allGames.map(g => {
            const panelId = `tags-${g.leaf}`;
            return (
              <li
                class="game-card group relative"
                data-type={g.type}
                data-mode={g.modeSlug || ''}
                data-tags={g.tags.join(',').toLowerCase()}
                data-title={(g.title || '').toLowerCase()}
                data-excerpt={(g.excerpt || '').toLowerCase()}
                data-search-visible="true"
              >
                <div class="glass relative p-3">
                  <div class="flex">
                    <picture class="mr-3 shrink-0">
                      <img
                        src={g.image}
                        alt={g.title}
                        loading="lazy"
                        decoding="async"
                        class="h-[88px] w-[88px] rounded-sm border border-fg/15 bg-fg/5 object-cover"
                        data-fb-key={g.leaf}
                        onerror="window.__imgFallback && window.__imgFallback(this)"
                      />
                    </picture>
                    <div class="flex min-w-0 flex-col">
                      <span class="mb-1 font-semibold leading-snug transition-colors group-hover:text-fg">
                        {g.title}
                      </span>
                      {g.excerpt && (
                        <p class="mb-2 line-clamp-2 text-xs leading-snug text-muted">{g.excerpt}</p>
                      )}

                      {/* Chips row (kept at z-index 60 so per-card tags dropdown (z:55) sits under chips) */}
                      <div
                        class="chip-row flex flex-wrap gap-2 text-[11px] font-semibold tracking-wide"
                        style="position: relative; z-index: 60;"
                      >
                        <button
                          type="button"
                          class="pill pill--filled tone-cyan js-card-chip"
                          data-chip-type="category"
                          data-chip-value={g.type}
                          aria-pressed="false"
                          title={`Filter: ${g.type}`}
                        >
                          {g.type}
                        </button>

                        {g.modeSlug && (
                          <button
                            type="button"
                            class="pill pill--filled tone-cyan js-card-chip"
                            data-chip-type="mode"
                            data-chip-value={g.modeSlug}
                            aria-pressed="false"
                            title={`Filter: ${playerModeLabel(g.rawMode!)}`}
                          >
                            {playerModeLabel(g.rawMode!)}
                          </button>
                        )}

                        {g.tags.length > 0 && (
                          <div class="relative inline-block" data-card-tags>
                            <button
                              type="button"
                              class="pill pill--filled tone-cyan"
                              aria-haspopup="listbox"
                              aria-expanded="false"
                              aria-controls={panelId}
                              data-open-card-tags
                              title="Show tags for this game"
                            >
                              {g.tags.length} tag{g.tags.length !== 1 && 's'}
                            </button>
                            <div
                              class="filter-panel narrow"
                              id={panelId}
                              role="group"
                              aria-label={`Tags for ${g.title}`}
                              data-card-tags-panel
                              style="position: absolute; z-index: 55; display: none; right: 0; left: auto;"
                            >
                              <div class="panel-inner panel-inner-col">
                                {g.tags.map(t => (
                                  <button
                                    type="button"
                                    class="filter-item pill pill--soft block w-full justify-between text-left"
                                    data-filter-type="tag"
                                    data-value={t}
                                    aria-pressed="false"
                                  >
                                    <span>{t}</span>
                                  </button>
                                ))}
                              </div>
                            </div>
                          </div>
                        )}
                      </div>
                    </div>
                  </div>
                </div>

                <a
                  href={g.href}
                  aria-label={`View game: ${g.title}`}
                  class="overlay-link absolute inset-0 rounded-md"
                  data-card-link
                >
                  <span class="sr-only">{g.title}</span>
                </a>
              </li>
            );
          })}
        </ul>
      )
    }

    <!-- Share and Feedback (no extra headings) -->
    <div class="mt-12">
      <ShareButtons title="Games" />
      <FeedbackCard />
    </div>

    <p class="mt-10 text-sm"></p>
  </div>

  <style is:inline>
    /* Card lift */
    .game-card:hover > .glass,
    .game-card:focus-within > .glass {
      transform: translateY(-2px);
      border-color: rgba(255, 255, 255, 0.18);
      box-shadow:
        0 22px 44px rgba(0, 0, 0, 0.4),
        inset 0 1px 0 rgba(255, 255, 255, 0.08);
    }

    .game-card {
      cursor: pointer;
    }
    .game-card > a.overlay-link {
      pointer-events: none;
    }

    .filter-toggle,
    #exclusive-toggle,
    #clear-filters {
      text-transform: none !important;
    }

    /* Top filter dropdowns: drop to the right (attach left edge) */
    [data-filter-wrapper] .filter-panel {
      left: 0;
      right: auto;
      width: max-content;
      max-width: min(92vw, 320px);
      z-index: 1200; /* ensure above card chip rows (z:60) */
    }
    /* Per-card tags dropdown: drop to the left (attach right edge) and stay under chip row */
    [data-card-tags] [data-card-tags-panel] {
      right: 0;
      left: auto;
      width: max-content;
      max-width: min(90vw, 260px);
      z-index: 55;
    }

    /* Opaque per-card tags panel (fallback if global CSS not loaded yet) */
    [data-card-tags-panel] {
      background-color: var(--bg) !important;
      background-image: none !important;
      -webkit-backdrop-filter: none !important;
      backdrop-filter: none !important;
      filter: none !important;
      mix-blend-mode: normal !important;
      border: 1px solid rgba(255, 255, 255, 0.18) !important;
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.55) !important;
    }
    [data-card-tags-panel] .panel-inner {
      background: transparent !important;
      border: 0 !important;
      box-shadow: none !important;
    }

    .filter-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      text-decoration: none;
      cursor: pointer;
      font-size: 0.75rem;
      line-height: 1;
      padding: 4px 0;
    }

    #clear-filters[aria-disabled='true'] {
      color: rgba(255, 255, 255, 0.5);
      pointer-events: none;
      cursor: default;
    }

    #exclusive-toggle .dot {
      width: 8px;
      height: 8px;
      border-radius: 9999px;
      background: #c33;
      box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.25) inset;
      transition: background-color 0.15s ease-in-out;
    }
    #exclusive-toggle[aria-pressed='true'] .dot {
      background: #16a34a;
    }
  </style>

  <script type="module" src={withBase('scripts/games-filters.js')}></script>
  <script type="module" src={withBase('scripts/games-ui.js')}></script>
</Layout>
