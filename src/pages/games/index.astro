---
import Layout from '../../components/Layout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/paths';
import { canonical } from '../../lib/urls';
import { excludeLegacyNoise } from '../../lib/filters';
import { playerModeSlug, playerModeLabel } from '../../lib/playerMode';

const raw = excludeLegacyNoise(await getCollection('games'));

const allGames = raw
  .map(g => {
    const full = g.slug ?? g.id;
    const leaf = full.split('/').pop();
    const type = (g.data.type || 'misc').toString();
    const rawMode = g.data.format || g.data.players;
    const modeSlug = rawMode ? playerModeSlug(rawMode) : '';
    const tags = Array.isArray(g.data.tags) ? g.data.tags : [];
    const excerpt = (g.data.excerpt || '').toString();
    return {
      title: g.data.title,
      type, rawMode, modeSlug, tags, excerpt, leaf,
      image: withBase(`images/${leaf}.webp`),
      href: withBase(`games/${leaf}/`)
    };
  })
  .sort((a,b)=> (a.title||'').localeCompare(b.title||''));

const categoryCounts = new Map<string, number>();
const modeCounts = new Map<string, { count: number; label: string }>();
const tagCounts = new Map<string, number>();
for (const g of allGames) {
  categoryCounts.set(g.type, (categoryCounts.get(g.type) || 0) + 1);
  if (g.modeSlug && g.rawMode) {
    const prev = modeCounts.get(g.modeSlug);
    if (prev) prev.count += 1;
    else modeCounts.set(g.modeSlug, { count: 1, label: playerModeLabel(g.rawMode) });
  }
  for (const t of g.tags) tagCounts.set(t, (tagCounts.get(t) || 0) + 1);
}
const categories = Array.from(categoryCounts.entries()).sort((a,b)=> a[0].localeCompare(b[0]));
const modes = Array.from(modeCounts.entries()).sort((a,b)=> a[1].label.localeCompare(b[1].label));
const tags = Array.from(tagCounts.entries()).sort((a,b)=> a[0].localeCompare(b[0]));

const pageCanonical = canonical(Astro.url.pathname, Astro.site);
---
<Layout
  title="Games"
  description="All drinking games. Filter or search by category, player mode, or tags."
  canonical={pageCanonical}
  wide={true}
>
  <div class="tone-cyan">
    <h1 class="font-display text-4xl mb-4 tone-cyan-text">Games</h1>
    <p class="text-sm text-muted mb-5">
      A complete collection of all games A–Z. Use search and filters, or pick a
      <a class="hover:text-fg underline underline-offset-4" href={withBase('games/random')}>Random Game</a>
    </p>

    <div class="divider" aria-hidden="true"></div>

    <!-- Row 1: Search -->
    <div class="mb-4">
      <div class="flex items-end gap-2 md:mr-4">
        <label class="text-xs uppercase tracking-wide text-muted font-medium flex flex-col gap-1">
          Search
          <input
            id="game-search"
            type="search"
            placeholder="Search games..."
            class="w-full md:w-96 rounded border border-fg/30 bg-fg/5 px-3 py-2 text-sm focus:outline-none focus:ring-2"
            autocomplete="off"
          />
        </label>
        <button id="game-search-clear" class="hidden text-[11px] underline underline-offset-4 hover:text-fg mb-1.5">Clear</button>
        <span id="search-hits" class="text-[11px] text-muted mb-2"></span>
      </div>
    </div>

    <!-- Row 2: Filters -->
    <div class="mb-6">
      <div class="flex flex-wrap gap-2 items-center">
        <span class="text-[11px] uppercase tracking-wide text-muted/70">Filters</span>

        <div class="relative" data-filter-wrapper>
          <button type="button" class="filter-toggle pill pill--soft uppercase" data-panel="categories" aria-expanded="false">
            Categories
          </button>
          <div class="filter-panel hidden" id="panel-categories" role="group" aria-label="Categories">
            <div class="panel-inner">
              {categories.map(([cat, count]) => (
                <button type="button" class="filter-item pill pill--filled tone-cyan uppercase" data-filter-type="category" data-value={cat} aria-pressed="false">
                  <span>{cat}</span><span class="count">{count}</span>
                </button>
              ))}
            </div>
          </div>
        </div>

        <div class="relative" data-filter-wrapper>
          <button type="button" class="filter-toggle pill pill--soft uppercase" data-panel="modes" aria-expanded="false">
            Player Modes
          </button>
          <div class="filter-panel hidden" id="panel-modes" role="group" aria-label="Player Modes">
            <div class="panel-inner">
              {modes.map(([slug, info]) => (
                <button type="button" class="filter-item pill pill--filled tone-cyan uppercase" data-filter-type="mode" data-value={slug} aria-pressed="false">
                  <span>{info.label}</span><span class="count">{info.count}</span>
                </button>
              ))}
            </div>
          </div>
        </div>

        <div class="relative" data-filter-wrapper>
          <button
            type="button"
            class="filter-toggle pill pill--soft uppercase"
            data-panel="tags"
            aria-expanded="false"
            data-tag-trigger
          >
            Tags
          </button>
          <div
            class="filter-panel hidden z-[70]"
            id="panel-tags"
            role="group"
            aria-label="Tags"
            data-tags-popover
          >
            <div class="panel-inner max-h-72">
              {tags.map(([t, count]) => (
                <button type="button" class="filter-item pill pill--soft uppercase" data-filter-type="tag" data-value={t} aria-pressed="false">
                  <span>{t}</span><span class="count">{count}</span>
                </button>
              ))}
            </div>
          </div>
        </div>

        <span class="ml-auto"></span>

        <button id="exclusive-toggle" type="button" class="pill pill--soft uppercase" aria-pressed="false">
          Exclusive
        </button>
        <button id="clear-filters" type="button" class="pill pill--soft uppercase disabled:opacity-40 disabled:cursor-not-allowed" disabled>
          Clear
        </button>

        <span id="result-count" class="text-xs text-muted"></span>
      </div>
    </div>

    {allGames.length === 0 ? (
      <p class="text-muted">No games found.</p>
    ) : (
      <ul id="game-grid" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5 list-none p-0 m-0">
        {allGames.map(g => {
          const tagPopoverId = `tags-${g.leaf}`;
          return (
            <li
              class="relative group"
              data-type={g.type}
              data-mode={g.modeSlug || ''}
              data-tags={g.tags.join(',').toLowerCase()}
              data-title={(g.title||'').toLowerCase()}
              data-excerpt={(g.excerpt||'').toLowerCase()}
              data-search-visible="true"
            >
              <div class="glass p-3 relative z-10">
                <div class="flex">
                  <picture class="mr-3 shrink-0">
                    <img
                      src={g.image}
                      alt={g.title}
                      loading="lazy"
                      decoding="async"
                      class="w-[88px] h-[88px] object-cover rounded-sm border border-fg/15 bg-fg/5"
                      onerror="this.style.display='none'"
                    />
                  </picture>
                  <div class="flex flex-col min-w-0">
                    <span class="font-semibold leading-snug mb-1 transition-colors group-hover:text-fg">
                      {g.title}
                    </span>
                    {g.excerpt && <p class="text-xs text-muted leading-snug line-clamp-2 mb-2">{g.excerpt}</p>}
                    <div class="flex flex-wrap gap-2 text-[10px] uppercase tracking-wide font-semibold relative z-[60]">
                      <button class="pill pill--filled tone-cyan js-filter uppercase" data-type="category" data-value={g.type} title={`Filter: ${g.type}`}>{g.type}</button>
                      {g.modeSlug && <button class="pill pill--filled tone-cyan js-filter uppercase" data-type="mode" data-value={g.modeSlug} title={`Filter: ${playerModeLabel(g.rawMode!)}`}>{playerModeLabel(g.rawMode!)}</button>}
                      {g.tags.length > 0 && (
                        <div class="relative inline-block">
                          <button
                            type="button"
                            class="pill pill--soft uppercase"
                            data-card-tag-trigger
                            aria-expanded="false"
                            aria-controls={tagPopoverId}
                          >
                            {g.tags.length} tag{g.tags.length !== 1 && 's'}
                          </button>
                          <div
                            id={tagPopoverId}
                            class="hidden absolute left-0 top-full mt-1 z-[70] p-2 rounded-md border border-fg/25 bg-bg/95 backdrop-blur shadow-lg flex flex-wrap gap-2 min-w-[6rem]"
                            role="group"
                            aria-label={`${g.title} tags`}
                            data-card-tags-popover
                          >
                            {g.tags.map(t => <button class="pill pill--soft js-filter uppercase" data-type="tag" data-value={t} title={`Filter: ${t}`}>{t}</button>)}
                          </div>
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              </div>
              <!-- Overlay link ABOVE card (but below chips/popovers) -->
              <a
                href={g.href}
                aria-label={`View game: ${g.title}`}
                class="absolute inset-0 rounded-md"
                style="z-index:50"
              >
                <span class="sr-only">{g.title}</span>
              </a>
            </li>
          );
        })}
      </ul>
    )}

    <p class="mt-10 text-sm">
      <a class="hover:text-fg underline underline-offset-4" href={withBase('/')}>← Back to Home</a>
    </p>
  </div>

  <script type="module" src={withBase('scripts/games-filters.js')}></script>

  <script is:inline>
    (() => {
      // Search integrates with filters
      const input = document.getElementById('game-search');
      const clear = document.getElementById('game-search-clear');
      const grid = document.getElementById('game-grid');
      const hitsEl = document.getElementById('search-hits');
      if(input && grid){
        const items = Array.from(grid.children);
        function applySearch() {
          const q = input.value.trim().toLowerCase();
          let hits = 0;
          items.forEach(li => {
            const title = li.getAttribute('data-title') || '';
            const tags = li.getAttribute('data-tags') || '';
            const type = li.getAttribute('data-type') || '';
            const excerpt = li.getAttribute('data-excerpt') || '';
            const match = !q || title.includes(q) || tags.includes(q) || type.includes(q) || excerpt.includes(q);
            li.dataset.searchVisible = match ? 'true' : 'false';
            if (match) hits++;
          });
          clear.classList.toggle('hidden', q.length === 0);
          if (hitsEl) hitsEl.textContent = q ? `${hits} match${hits===1?'':'es'}` : '';
          window.bggApplyGameFilters?.();
        }
        input.addEventListener('input', applySearch);
        clear.addEventListener('click', () => { input.value=''; applySearch(); input.focus(); });
        applySearch();
      }

      // Global "Tags" dropdown (filters row)
      const tagToggle = document.querySelector('[data-panel="tags"]');
      const tagPanel = document.getElementById('panel-tags');
      function closeTags(){ tagPanel?.classList.add('hidden'); tagToggle?.setAttribute('aria-expanded','false'); }
      tagToggle?.addEventListener('click', (e)=>{
        e.preventDefault();
        const open = tagPanel?.classList.contains('hidden') === false;
        if (open) { closeTags(); }
        else { tagPanel?.classList.remove('hidden'); tagToggle.setAttribute('aria-expanded','true'); }
      });
      document.addEventListener('click', (e)=>{
        const t = e.target;
        if (!(t instanceof Element)) return;
        if (!t.closest('[data-filter-wrapper]')) closeTags();
      });
      document.addEventListener('keydown', e => { if (e.key === 'Escape') closeTags(); });

      // Per-card tag popovers
      document.getElementById('game-grid')?.addEventListener('click', (e) => {
        const target = e.target;
        if (!(target instanceof HTMLElement)) return;

        // Toggle card tag popover
        const trigger = target.closest('[data-card-tag-trigger]');
        if (trigger) {
          e.preventDefault();
          const pop = trigger.parentElement?.querySelector('[data-card-tags-popover]');
          const open = pop && !pop.classList.contains('hidden');
          document.querySelectorAll('[data-card-tags-popover]').forEach(el => el.classList.add('hidden'));
          trigger.setAttribute('aria-expanded', open ? 'false' : 'true');
          if (pop) pop.classList.toggle('hidden', !!open);
          return;
        }

        // Clickable filter chips
        const chip = target.closest('.js-filter');
        if (chip) {
          const type = chip.getAttribute('data-type');
          const value = chip.getAttribute('data-value');
          if (type && value) {
            window.bggToggleGameFilter?.(type, value);
            window.bggApplyGameFilters?.();
          }
          return;
        }
      });

      // Close popovers when clicking elsewhere
      document.addEventListener('click', (e)=>{
        const t = e.target;
        if (!(t instanceof Element)) return;
        if (!t.closest('[data-card-tag-trigger]') && !t.closest('[data-card-tags-popover]')) {
          document.querySelectorAll('[data-card-tags-popover]').forEach(el => el.classList.add('hidden'));
        }
      });
    })();
  </script>
</Layout>
