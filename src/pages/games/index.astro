---
import Layout from '../../components/Layout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/paths';
import { canonical } from '../../lib/urls';
import { excludeLegacyNoise } from '../../lib/filters';
import { playerModeSlug, playerModeLabel } from '../../lib/playerMode';

const raw = excludeLegacyNoise(await getCollection('games'));

const allGames = raw
  .map(g => {
    const full = g.slug ?? g.id;
    const leaf = full.split('/').pop();
    const type = (g.data.type || 'misc').toString();
    const rawMode = g.data.format || g.data.players;
    const modeSlug = rawMode ? playerModeSlug(rawMode) : '';
    const tags = Array.isArray(g.data.tags) ? g.data.tags : [];
    const excerpt = (g.data.excerpt || '').toString();
    return {
      title: g.data.title,
      type, rawMode, modeSlug, tags, excerpt, leaf,
      image: withBase(`images/${leaf}.webp`),
      href: withBase(`games/${leaf}/`)
    };
  })
  .sort((a,b)=> (a.title||'').localeCompare(b.title||''));

const categoryCounts = new Map<string, number>();
const modeCounts = new Map<string, { count: number; label: string }>();
const tagCounts = new Map<string, number>();
for (const g of allGames) {
  categoryCounts.set(g.type, (categoryCounts.get(g.type) || 0) + 1);
  if (g.modeSlug && g.rawMode) {
    const prev = modeCounts.get(g.modeSlug);
    if (prev) prev.count += 1;
    else modeCounts.set(g.modeSlug, { count: 1, label: playerModeLabel(g.rawMode) });
  }
  for (const t of g.tags) tagCounts.set(t, (tagCounts.get(t) || 0) + 1);
}
const categories = Array.from(categoryCounts.entries()).sort((a,b)=> a[0].localeCompare(b[0]));
const modes = Array.from(modeCounts.entries()).sort((a,b)=> a[1].label.localeCompare(b[1].label));
const tags = Array.from(tagCounts.entries()).sort((a,b)=> a[0].localeCompare(b[0]));

const pageCanonical = canonical(Astro.url.pathname, Astro.site);
---
<Layout
  title="Games"
  description="All drinking games. Filter or search by category, player mode, or tags."
  canonical={pageCanonical}
  wide={true}
>
  <div class="tone-cyan">
    <h1 class="font-display text-4xl mb-4 tone-cyan-text">Games</h1>
    <p class="text-sm text-muted mb-5">
      A complete collection of all games A–Z. Use search and filters, or pick a
      <a class="hover:text-fg underline underline-offset-4" href={withBase('games/random')}>Random Game</a>
    </p>

    <div class="divider" aria-hidden="true"></div>

    <!-- Row 1: Search -->
    <div class="mb-4">
      <div class="flex items-end gap-2 md:mr-4">
        <label class="text-xs tracking-wide text-muted font-medium flex flex-col gap-1">
          <span>Search</span>
          <input
            id="game-search"
            type="search"
            placeholder="Search games..."
            class="w-full md:w-96 rounded border border-fg/30 bg-fg/5 px-3 py-2 text-sm focus:outline-none focus:ring-2"
            autocomplete="off"
          />
        </label>
        <span id="search-hits" class="text-[11px] text-muted mb-2"></span>
      </div>
    </div>

    <!-- Row 2: Filters -->
    <div class="mb-6">
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-[11px] uppercase tracking-wide text-muted/70">Filters</span>

        <div class="relative" data-filter-wrapper>
          <button type="button" class="filter-toggle pill pill--soft" data-panel="categories" data-filter-group="category" aria-expanded="false" aria-pressed="false">
            Categories
          </button>
          <div class="filter-panel hidden" id="panel-categories" role="group" aria-label="Categories">
            <div class="panel-inner">
              {categories.map(([cat, count]) => (
                <button
                  type="button"
                  class="filter-item pill pill--soft"
                  data-filter-type="category"
                  data-value={cat}
                  aria-pressed="false"
                >
                  <span>{cat}</span><span class="count">{count}</span>
                </button>
              ))}
            </div>
          </div>
        </div>

        <div class="relative" data-filter-wrapper>
          <button type="button" class="filter-toggle pill pill--soft" data-panel="modes" data-filter-group="mode" aria-expanded="false" aria-pressed="false">
            Player modes
          </button>
          <div class="filter-panel hidden" id="panel-modes" role="group" aria-label="Player modes">
            <div class="panel-inner">
              {modes.map(([slug, info]) => (
                <button
                  type="button"
                  class="filter-item pill pill--soft"
                  data-filter-type="mode"
                  data-value={slug}
                  aria-pressed="false"
                >
                  <span>{info.label}</span><span class="count">{info.count}</span>
                </button>
              ))}
            </div>
          </div>
        </div>

        <div class="relative" data-filter-wrapper>
          <button type="button" class="filter-toggle pill pill--soft" data-panel="tags" data-filter-group="tag" aria-expanded="false" aria-pressed="false" id="tags-toggle">
            Tags
          </button>
          <div class="filter-panel hidden" id="panel-tags" role="group" aria-label="Tags">
            <div class="panel-inner">
              {tags.map(([t, count]) => (
                <button
                  type="button"
                  class="filter-item pill pill--soft"
                  data-filter-type="tag"
                  data-value={t}
                  aria-pressed="false"
                >
                  <span>{t}</span><span class="count">{count}</span>
                </button>
              ))}
            </div>
          </div>
        </div>

        <!-- Exclusive and Clear: inline with filter buttons; small text; no underline -->
        <a href="#" id="exclusive-toggle" class="filter-link" aria-pressed="false">
          <span class="dot" aria-hidden="true"></span>
          Exclusive
        </a>
        <a href="#" id="clear-filters" class="filter-link text-muted" aria-disabled="true">
          Clear
        </a>

        <!-- Result count on the far right on all breakpoints -->
        <span id="result-count" class="text-xs text-muted ml-auto w-full sm:w-auto text-right"></span>
      </div>
    </div>

    {allGames.length === 0 ? (
      <p class="text-muted">No games found.</p>
    ) : (
      <ul id="game-grid" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-4 list-none p-0 m-0">
        {allGames.map(g => {
          const panelId = `tags-${g.leaf}`;
          return (
            <li
              class="game-card group relative"
              data-type={g.type}
              data-mode={g.modeSlug || ''}
              data-tags={g.tags.join(',').toLowerCase()}
              data-title={(g.title||'').toLowerCase()}
              data-excerpt={(g.excerpt||'').toLowerCase()}
              data-search-visible="true"
            >
              <div class="glass p-3 relative">
                <div class="flex">
                  <picture class="mr-3 shrink-0">
                    <img
                      src={g.image}
                      alt={g.title}
                      loading="lazy"
                      decoding="async"
                      class="w-[88px] h-[88px] object-cover rounded-sm border border-fg/15 bg-fg/5"
                      onerror="this.style.display='none'"
                    />
                  </picture>
                  <div class="flex flex-col min-w-0">
                    <span class="font-semibold leading-snug mb-1 transition-colors group-hover:text-fg">{g.title}</span>
                    {g.excerpt && <p class="text-xs text-muted leading-snug line-clamp-2 mb-2">{g.excerpt}</p>}

                    <!-- Chips row -->
                    <div class="chip-row flex flex-wrap gap-2 text-[11px] tracking-wide font-semibold" style="position: relative; z-index: 30;">
                      <!-- Category chip: clickable to filter -->
                      <button
                        type="button"
                        class="pill pill--filled tone-cyan js-card-chip"
                        data-chip-type="category"
                        data-chip-value={g.type}
                        aria-pressed="false"
                        title={`Filter: ${g.type}`}
                      >
                        {g.type}
                      </button>

                      <!-- Mode chip: clickable to filter (if present) -->
                      {g.modeSlug && (
                        <button
                          type="button"
                          class="pill pill--filled tone-cyan js-card-chip"
                          data-chip-type="mode"
                          data-chip-value={g.modeSlug}
                          aria-pressed="false"
                          title={`Filter: ${playerModeLabel(g.rawMode!)}`}
                        >
                          {playerModeLabel(g.rawMode!)}
                        </button>
                      )}

                      <!-- Tag pill and dropdown -->
                      {g.tags.length > 0 && (
                        <div class="relative inline-block" data-card-tags>
                          <button
                            type="button"
                            class="pill pill--filled tone-cyan"
                            aria-haspopup="listbox"
                            aria-expanded="false"
                            aria-controls={panelId}
                            data-open-card-tags
                            title="Show tags for this game"
                          >
                            {g.tags.length} tag{g.tags.length !== 1 && 's'}
                          </button>
                          <div
                            class="filter-panel narrow"
                            id={panelId}
                            role="group"
                            aria-label={`Tags for ${g.title}`}
                            data-card-tags-panel
                            style="position: absolute; z-index: 40; display: none; right: 0; left: auto;"
                          >
                            <div class="panel-inner panel-inner-col">
                              {g.tags.map(t => (
                                <button
                                  type="button"
                                  class="filter-item pill pill--soft w-full justify-between text-left block"
                                  data-filter-type="tag"
                                  data-value={t}
                                  aria-pressed="false"
                                >
                                  <span>{t}</span>
                                </button>
                              ))}
                            </div>
                          </div>
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              </div>

              <!-- Overlay link on top but not intercepting pointer events -->
              <a href={g.href} aria-label={`View game: ${g.title}`} class="overlay-link absolute inset-0 rounded-md" data-card-link>
                <span class="sr-only">{g.title}</span>
              </a>
            </li>
          );
        })}
      </ul>
    )}

    <p class="mt-10 text-sm">
      <a class="hover:text-fg underline underline-offset-4" href={withBase('/')}>← Back to Home</a>
    </p>
  </div>

  <style is:inline>
    /* Card lift */
    .game-card:hover > .glass,
    .game-card:focus-within > .glass {
      transform: translateY(-2px);
      border-color: rgba(255,255,255,0.18);
      box-shadow: 0 22px 44px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.08);
    }

    /* Make the whole card clickable via JS, but don't intercept chip/tag interactions */
    .game-card > a.overlay-link { pointer-events: none; }

    /* Force filter toggle buttons to normal case */
    .filter-toggle,
    #exclusive-toggle,
    #clear-filters { text-transform: none !important; }

    /* Keep dropdowns within the viewport and narrower */
    [data-filter-wrapper] .filter-panel {
      right: 0; left: auto;
      width: max-content; max-width: min(92vw, 320px);
    }
    [data-card-tags] .filter-panel {
      right: 0; left: auto;
      width: max-content; max-width: min(90vw, 260px);
      /* Increase opacity for better readability */
      background-color: rgba(0,0,0,0.9);
      border: 1px solid rgba(255,255,255,0.18);
    }

    /* Show per-card tag dropdown on hover or keyboard focus */
    [data-card-tags]:hover [data-card-tags-panel],
    [data-card-tags]:focus-within [data-card-tags-panel] {
      display: block !important;
    }

    /* Link-style controls for Exclusive and Clear: small text, no underline */
    .filter-link {
      display: inline-flex; align-items: center; gap: 6px;
      text-decoration: none; /* no underline */
      cursor: pointer;
      font-size: 0.75rem; line-height: 1; /* text-xs */
      padding: 4px 0;
    }
    /* Slightly more space between Exclusive and Clear */
    .filter-link + .filter-link { margin-left: 12px; }

    /* Disabled Clear styling */
    #clear-filters[aria-disabled="true"] {
      color: rgba(255,255,255,0.5); /* greyed out */
      pointer-events: none; cursor: default;
    }

    /* Exclusive status dot: red when off, green when on */
    #exclusive-toggle .dot {
      width: 8px; height: 8px; border-radius: 9999px;
      background: #c33; box-shadow: 0 0 0 1px rgba(0,0,0,0.25) inset;
      transition: background-color .15s ease-in-out;
    }
    #exclusive-toggle[aria-pressed="true"] .dot { background: #16a34a; } /* green */
  </style>

  <script type="module" src={withBase('scripts/games-filters.js')}></script>

  <script is:inline>
    (() => {
      // Make the entire card clickable via JS (overlay link has pointer-events: none)
      document.getElementById('game-grid')?.addEventListener('click', (e) => {
        const t = e.target;
        if (!(t instanceof Element)) return;

        // If interacting with tag pill/dropdown or card chips, do nothing (let those handle)
        if (t.closest('[data-card-tags]') || t.closest('.js-card-chip')) return;

        const card = t.closest('.game-card');
        if (!card) return;
        const a = card.querySelector('a[data-card-link]');
        if (!(a instanceof HTMLAnchorElement)) return;
        window.location.href = a.href;
      });

      // Card chip clicks (category/mode) -> apply filters
      document.getElementById('game-grid')?.addEventListener('click', (e) => {
        const t = e.target;
        if (!(t instanceof Element)) return;
        const chip = t.closest('.js-card-chip');
        if (!chip) return;

        e.preventDefault();
        e.stopPropagation();

        const type = chip.getAttribute('data-chip-type');
        const value = chip.getAttribute('data-chip-value');
        if (!type || !value) return;

        const pressed = chip.getAttribute('aria-pressed') === 'true';
        chip.setAttribute('aria-pressed', pressed ? 'false' : 'true');

        window.bggToggleGameFilter?.(type, value);
        window.bggApplyGameFilters?.();
      });

      // Search integrates with filters
      const input = document.getElementById('game-search');
      const grid = document.getElementById('game-grid');
      const hitsEl = document.getElementById('search-hits');

      if (input && grid) {
        const items = Array.from(grid.children);
        function applySearch() {
          const q = input.value.trim().toLowerCase();
          let hits = 0;
          items.forEach(li => {
            const title = li.getAttribute('data-title') || '';
            const tags = li.getAttribute('data-tags') || '';
            const type = li.getAttribute('data-type') || '';
            const excerpt = li.getAttribute('data-excerpt') || '';
            const match = !q || title.includes(q) || tags.includes(q) || type.includes(q) || excerpt.includes(q);
            li.dataset.searchVisible = match ? 'true' : 'false';
            if (match) hits++;
          });
          if (hitsEl) hitsEl.textContent = q ? `${hits} match${hits===1?'':'es'}` : '';
          window.bggApplyGameFilters?.();
        }
        input.addEventListener('input', applySearch);
        applySearch();
      }

      // Generic filter panel toggles (Categories, Player modes, Tags)
      const wrappers = document.querySelectorAll('[data-filter-wrapper]');
      function closeAllPanels(except) {
        wrappers.forEach(w => {
          const btn = w.querySelector('.filter-toggle');
          const panel = w.querySelector('.filter-panel');
          if (!panel) return;
          if (panel !== except) {
            panel.classList.add('hidden');
            btn?.setAttribute('aria-expanded', 'false');
          }
        });
      }
      wrappers.forEach(w => {
        const btn = w.querySelector('.filter-toggle');
        const panel = w.querySelector('.filter-panel');
        if (!btn || !panel) return;
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const isOpen = !panel.classList.contains('hidden');
          closeAllPanels(isOpen ? null : panel);
          if (isOpen) {
            panel.classList.add('hidden');
            btn.setAttribute('aria-expanded','false');
          } else {
            panel.classList.remove('hidden');
            btn.setAttribute('aria-expanded','true');
          }
        });
      });
      document.addEventListener('click', (e) => {
        const t = e.target;
        if (!(t instanceof Element)) return;
        if (!t.closest('[data-filter-wrapper]')) closeAllPanels(null);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeAllPanels(null);
      });

      // Per-card tag dropdown click toggle (touch fallback)
      document.getElementById('game-grid')?.addEventListener('click', (e) => {
        const t = e.target;
        if (!(t instanceof Element)) return;
        const trigger = t.closest('[data-open-card-tags]');
        if (!trigger) return;
        e.preventDefault();
        e.stopPropagation();
        const holder = trigger.closest('[data-card-tags]');
        const panel = holder?.querySelector('[data-card-tags-panel]');
        const expanded = trigger.getAttribute('aria-expanded') === 'true';
        document.querySelectorAll('[data-card-tags-panel]').forEach(p => (p instanceof HTMLElement) && (p.style.display = 'none'));
        document.querySelectorAll('[data-open-card-tags]').forEach(b => b.setAttribute('aria-expanded','false'));
        if (!expanded) {
          if (panel instanceof HTMLElement) panel.style.display = 'block';
          trigger.setAttribute('aria-expanded','true');
        }
      });
      document.addEventListener('click', (e)=>{
        const t = e.target;
        if (!(t instanceof Element)) return;
        if (!t.closest('[data-card-tags]')) {
          document.querySelectorAll('[data-card-tags-panel]').forEach(p => (p instanceof HTMLElement) && (p.style.display = 'none'));
          document.querySelectorAll('[data-open-card-tags]').forEach(b => b.setAttribute('aria-expanded','false'));
        }
      });
      document.addEventListener('keydown', e => {
        if (e.key === 'Escape') {
          document.querySelectorAll('[data-card-tags-panel]').forEach(p => (p instanceof HTMLElement) && (p.style.display = 'none'));
          document.querySelectorAll('[data-open-card-tags]').forEach(b => b.setAttribute('aria-expanded','false'));
        }
      });
    })();
  </script>
</Layout>
