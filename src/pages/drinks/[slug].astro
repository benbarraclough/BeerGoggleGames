---
import Layout from '../../components/Layout.astro';
import { getCollection } from 'astro:content';
import { canonical } from '../../lib/urls';
import { withBase } from '../../lib/paths';

export async function getStaticPaths() {
  const entries = await getCollection('drinks');
  const leafMap = new Map<string, any>();
  const duplicates: string[] = [];
  for (const e of entries) {
    const leaf = (e.slug ?? e.id).split('/').pop()!;
    if (leafMap.has(leaf)) duplicates.push(leaf);
    else leafMap.set(leaf, e);
  }
  if (duplicates.length) throw new Error(`[drinks] Duplicate leaf slug(s): ${duplicates.join(', ')}`);
  return Array.from(leafMap.keys()).map(leaf => ({ params: { slug: leaf } }));
}

const leaf = Astro.params.slug;
const allEntries = await getCollection('drinks');
const leafMap = new Map<string, any>();
for (const e of allEntries) {
  const l = (e.slug ?? e.id).split('/').pop()!;
  if (!leafMap.has(l)) leafMap.set(l, e);
}
const entry = leafMap.get(leaf);
if (!entry) throw new Error(`Drink not found for leaf "${leaf}"`);

const { Content } = await entry.render();

const data = entry.data;
const title = data.title;
const description = data.excerpt || data.description || `Drink recipe: ${title}`;
const drinkType = (data.drinkType || '').toString();
const difficulty = (data.difficulty || '').toString();
const baseList: string[] = Array.isArray(data.bases) ? data.bases : data.base ? [data.base] : [];
const tags: string[] = Array.isArray(data.tags) ? data.tags : [];
const coverFile = data.cover || `${leaf}.webp`;
const cover = withBase(`images/${coverFile}`);
const heroDisabled = data.hero === false;
const pageCanonical = canonical(Astro.url.pathname, Astro.site);

const jsonLd = { '@context': 'https://schema.org', '@type': 'Recipe', name: title, description, recipeCategory: drinkType || 'drink', keywords: [...tags, drinkType, difficulty, ...baseList].filter(Boolean).join(', ') };
---
<Layout title={title} description={description} canonical={pageCanonical} image={cover}>
  <article class="prose-invert max-w-none tone-magenta">
    <header class="drink-meta mb-6">
      <h1 class="font-display text-4xl mb-2 tone-magenta-text">{title}</h1>
      {description && (
        <p class="text-lg text-muted mb-4 leading-relaxed max-w-prose">
          {description}
        </p>
      )}
      <div class="flex flex-wrap gap-2">
        {drinkType && <span class="pill pill--soft" aria-label={`Drink type: ${drinkType}`}>{drinkType}</span>}
        {baseList.map(b => (<span class="pill pill--soft" aria-label={`Base: ${b}`}>{b}</span>))}
        {difficulty && (<span class="pill pill--soft" aria-label={`Difficulty: ${difficulty}`}>{difficulty}</span>)}
        {tags.map(t => (<span class="pill pill--soft" aria-label={`Tag: ${t}`}>{t}</span>))}
      </div>
    </header>

    <div class="divider" aria-hidden="true"></div>

    {!heroDisabled && (
      <figure class="relative mb-8 aspect-[16/7] overflow-hidden rounded-xl border border-fg/20">
        <img
          src={cover}
          alt={title}
          class="hero-img w-full h-full object-cover brightness-90 saturate-110 transition-transform duration-700"
          loading="lazy"
          decoding="async"
          onerror="this.style.display='none'"
        />
        <div class="absolute inset-0 bg-gradient-to-tr from-bg/80 via-bg/20 to-transparent pointer-events-none"></div>
      </figure>
    )}

    <Content />

    <p class="mt-10 text-xs text-muted">
      <a class="hover:underline" href={withBase('drinks/')}>Back to Drinks Index</a>
    </p>
  </article>

  <!-- Add icons before section headings -->
  <script is:inline>
    (function(){
      const map = [
        { re: /(overview|about)/i, icon: '/images/info.webp' },
        { re: /(equipment|items|gear|glass)/i, icon: '/images/liquor.webp' },
        { re: /(setup|prepare|start)/i, icon: '/images/settings.webp' },
        { re: /(aim|goal|objective|target)/i, icon: '/images/target.webp' },
        { re: /(how to|play|steps|instructions|method|recipe)/i, icon: '/images/question.webp' },
        { re: /(rules?|guidelines|dos|donts)/i, icon: '/images/rules.webp' },
        { re: /(tips|advice|hints|notes)/i, icon: '/images/lightbulb.webp' },
        { re: /(special|variants|edition|extras?)/i, icon: '/images/special.webp' }
      ];
      function matchIcon(text){
        for (const m of map) if (m.re.test(text)) return m.icon;
        return null;
      }
      document.querySelectorAll('article h2, article h3').forEach(h => {
        if (h.querySelector('.section-icon')) return;
        const icon = matchIcon(h.textContent || '');
        if (!icon) return;
        const span = document.createElement('span');
  span.className = 'section-icon inline-flex w-9 h-9 items-center justify-center rounded-lg bg-fg/5 border border-fg/15 mr-2 align-middle';
        span.innerHTML = `<img src="${icon}" alt="" class="w-5 h-5 object-contain opacity-90" loading="lazy" />`;
        h.prepend(span);
      });
    })();
  </script>

  <style is:global>
    @media (hover: hover) { .hero-img:hover { transform: scale(1.05); } }
  </style>

  <script type="application/ld+json">
    {JSON.stringify(jsonLd, null, 2)}
  </script>
</Layout>
