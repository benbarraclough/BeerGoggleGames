---
import Layout from '../../components/Layout.astro';
import BackLink from '../../components/BackLink.astro';
import { getCollection } from 'astro:content';
import { canonical } from '../../lib/urls';
import { withBase } from '../../lib/paths';

export async function getStaticPaths() {
  const entries = await getCollection('drinks');
  const leafMap = new Map<string, any>();
  const duplicates: string[] = [];
  for (const e of entries) {
    const leaf = (e.slug ?? e.id).split('/').pop()!;
    if (leafMap.has(leaf)) duplicates.push(leaf);
    else leafMap.set(leaf, e);
  }
  if (duplicates.length)
    throw new Error(`[drinks] Duplicate leaf slug(s): ${duplicates.join(', ')}`);
  return Array.from(leafMap.keys()).map(leaf => ({ params: { slug: leaf } }));
}

const leaf = Astro.params.slug;
const allEntries = await getCollection('drinks');
const leafMap = new Map<string, any>();
for (const e of allEntries) {
  const l = (e.slug ?? e.id).split('/').pop()!;
  if (!leafMap.has(l)) leafMap.set(l, e);
}
const entry = leafMap.get(leaf);
if (!entry) throw new Error(`Drink not found for leaf "${leaf}"`);

const { Content } = await entry.render();

const data = entry.data;
const title = data.title;
const description = data.excerpt || data.description || `Drink recipe: ${title}`;
const drinkType = (data.drinkType || '').toString();
const difficulty = (data.difficulty || '').toString();
const baseList: string[] = Array.isArray(data.bases) ? data.bases : data.base ? [data.base] : [];
const tags: string[] = Array.isArray(data.tags) ? data.tags : [];
const coverFile = data.cover || `${leaf}.webp`;
const cover = (() => {
  const s = String(coverFile);
  // If frontmatter already provides an images path (e.g. "/images/foo.webp" or "images/foo.webp"), use it as-is
  if (/^\/?images\//.test(s)) return withBase(s.replace(/^\//, ''));
  // Otherwise assume a filename and prefix images/
  return withBase(`images/${s}`);
})();
const heroDisabled = data.hero === false;
const pageCanonical = canonical(Astro.url.pathname, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  name: title,
  description,
  recipeCategory: drinkType || 'drink',
  keywords: [...tags, drinkType, difficulty, ...baseList].filter(Boolean).join(', '),
};
---

<Layout title={title} description={description} canonical={pageCanonical} image={cover}>
  <article class="tone-magenta prose-invert max-w-none">
    <header class="drink-meta mb-6">
      <h1 class="tone-magenta-text mb-2 font-display text-4xl">{title}</h1>
      {
        description && (
          <p class="mb-4 max-w-prose text-lg leading-relaxed text-muted">{description}</p>
        )
      }
      <div class="flex flex-wrap gap-2">
        {
          drinkType && (
            <span class="pill pill--soft" aria-label={`Drink type: ${drinkType}`}>
              {drinkType}
            </span>
          )
        }
        {
          baseList.map(b => (
            <span class="pill pill--soft" aria-label={`Base: ${b}`}>
              {b}
            </span>
          ))
        }
        {
          difficulty && (
            <span class="pill pill--soft" aria-label={`Difficulty: ${difficulty}`}>
              {difficulty}
            </span>
          )
        }
        {
          tags.map(t => (
            <span class="pill pill--soft" aria-label={`Tag: ${t}`}>
              {t}
            </span>
          ))
        }
      </div>
    </header>

    {
      !heroDisabled && (
        <figure class="relative mb-8 aspect-[16/7] overflow-hidden rounded-xl border border-fg/20">
          <img
            src={cover}
            alt={title}
            class="hero-img saturate-110 h-full w-full object-cover brightness-90 transition-transform duration-700"
            loading="lazy"
            decoding="async"
            onerror="this.style.display='none'"
          />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-tr from-bg/80 via-bg/20 to-transparent" />
        </figure>
      )
    }

    <Content />

    <BackLink href={withBase('drinks/')} label="Back to Drinks" />
  </article>

  <!-- Add icons before section headings using inline SVGs -->
  <script is:inline>
    (function () {
      function svg(name) {
        switch (name) {
          case 'info':
            return `<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='9'/><path d='M12 8h.01'/><path d='M12 12v4'/></svg>`;
          case 'tools':
            return `<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M14.7 6.3a4 4 0 1 0-5.66 5.66l8 8a2 2 0 0 0 2.83-2.83l-8-8Z'/><path d='M5 13l-3 3 3 3 3-3'/><path d='M7 11l-2 2'/></svg>`;
          case 'settings':
            return `<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z'/><path d='M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06A2 2 0 1 1 7.04 3.3l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06A2 2 0 1 1 20.7 7.04l-.06.06a1.65 1.65 0 0 0-.33 1.82V9c0 .66.26 1.3.73 1.77.47.47 1.11.73 1.77.73H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z'/></svg>`;
          case 'target':
            return `<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='9'/><circle cx='12' cy='12' r='3'/><path d='M12 3v3M21 12h-3M12 21v-3M3 12h3'/></svg>`;
          case 'howto':
            return `<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M4 19.5A2.5 2.5 0 0 1 6.5 17H20'/><path d='M20 22H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20Z'/><path d='M8 7h8M8 11h6'/></svg>`;
          case 'rules':
            return `<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M5 4h14v16H5z'/><path d='M9 8h6M9 12h6M9 16h6'/></svg>`;
          case 'tips':
            return `<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M9 18h6M10 22h4'/><path d='M2 12h2M20 12h2M12 2v2M4.93 4.93l1.41 1.41M17.66 4.93l-1.41 1.41'/><path d='M12 8a4 4 0 0 1 4 4c0 1.5-.5 2.5-1.5 3.5-.7.7-1 1.5-1 2.5h-3c0-1-.3-1.8-1-2.5C8.5 14.5 8 13.5 8 12a4 4 0 0 1 4-4Z'/></svg>`;
          case 'special':
            return `<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M12 2 3 7v10l9 5 9-5V7l-9-5Z'/><path d='M12 8v8M8 12h8'/></svg>`;
        }
      }
      const map = [
        { re: /(overview|about)/i, icon: 'info' },
        { re: /(equipment|items|gear|tools|requirements|ingredients)/i, icon: 'tools' },
        { re: /(setup|prepare|start)/i, icon: 'settings' },
        { re: /(aim|goal|objective|target)/i, icon: 'target' },
        { re: /(how to|play|steps|instructions|method|recipe)/i, icon: 'howto' },
        { re: /(rules?|guidelines|dos|donts)/i, icon: 'rules' },
        { re: /(tips|advice|hints|notes)/i, icon: 'tips' },
        { re: /(special|variants|edition|extras?)/i, icon: 'special' },
      ];
      function matchIcon(text) {
        for (const m of map) if (m.re.test(text)) return m.icon;
        return null;
      }
      document.querySelectorAll('article h2, article h3').forEach(h => {
        if (h.querySelector('.section-icon')) return;
        const icon = matchIcon(h.textContent || '');
        if (!icon) return;
        const span = document.createElement('span');
        span.className =
          'section-icon inline-flex w-9 h-9 items-center justify-center rounded-lg bg-fg/5 border border-fg/15 mr-2 align-middle';
        const color = icon === 'special' ? 'text-yellow-400' : 'text-fg/80';
        span.innerHTML = `<span class="w-5 h-5 ${color}" aria-hidden="true">${svg(icon)}</span>`;
        h.prepend(span);
      });
    })();
  </script>

  <style is:global>
    @media (hover: hover) {
      .hero-img:hover {
        transform: scale(1.05);
      }
    }
  </style>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd, null, 2)} />
</Layout>
