---
import Layout from '../../components/Layout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/paths';
import { canonical } from '../../lib/urls';
import { excludeLegacyNoise } from '../../lib/filters';

interface DrinkMeta {
  title: string;
  drinkType: string;
  bases: string[];
  basesLC: string[];
  difficulty: string;
  slug: string;
  href: string;
  image: string;
  excerpt: string;
}

function collectBases(data: any): string[] {
  if (Array.isArray(data.bases) && data.bases.length) return data.bases.map((b: any) => (b ?? '').toString().trim()).filter(Boolean);
  if (data.base) return [data.base].map((b: any) => (b ?? '').toString().trim()).filter(Boolean);
  return [];
}

const entries = excludeLegacyNoise(await getCollection('drinks'));
const drinks: DrinkMeta[] = entries
  .map(e => {
    const slug = (e.slug ?? e.id).split('/').pop();
    const drinkType = (e.data.drinkType || 'drink').toString().trim().toLowerCase();
    const bases = collectBases(e.data);
    const difficulty = (e.data.difficulty || '').toString().trim().toLowerCase();
    const excerpt = (e.data.excerpt || e.data.description || '').toString().trim();
    return {
      title: e.data.title,
      drinkType,
      bases,
      basesLC: bases.map(b => b.toLowerCase()),
      difficulty,
      slug,
      href: withBase(`drinks/${slug}/`),
      image: withBase(`images/${slug}.webp`),
      excerpt
    };
  })
  .sort((a,b)=> (a.title||'').localeCompare(b.title||''));

const typeCounts = new Map<string, number>();
const baseCounts = new Map<string, number>();
const diffCounts = new Map<string, number>();
for (const d of drinks) {
  typeCounts.set(d.drinkType, (typeCounts.get(d.drinkType) || 0) + 1);
  d.bases.forEach(b => baseCounts.set(b, (baseCounts.get(b) || 0) + 1));
  if (d.difficulty) diffCounts.set(d.difficulty, (diffCounts.get(d.difficulty) || 0) + 1);
}

const drinkTypes = Array.from(typeCounts.entries()).sort((a,b)=> a[0].localeCompare(b[0]));
const bases = Array.from(baseCounts.entries()).sort((a,b)=> a[0].localeCompare(b[0]));
const diffOrder = ['easy','medium','hard'];
const difficulties = Array.from(diffCounts.entries()).sort((a,b)=>{
  const ai = diffOrder.indexOf(a[0]); const bi = diffOrder.indexOf(b[0]);
  if (ai === -1 || bi === -1) return a[0].localeCompare(b[0]);
  return ai - bi;
});

const pageCanonical = canonical(Astro.url.pathname, Astro.site);
---
<Layout
  title="Drinks"
  description="A complete collection of all drink recipes A–Z. Use search and filters, or pick a Random Drink."
  canonical={pageCanonical}
  wide={true}
>
  <div class="tone-magenta">
    <h1 class="font-display text-4xl mb-4 tone-magenta-text">Drinks</h1>
    <p class="text-sm text-muted mb-5">
      A complete collection of all drink recipes A–Z. Use search and filters, or pick a
      <a class="hover:underline" href={withBase('drinks/random')}>Random Drink</a>.
    </p>

    <div class="divider" aria-hidden="true"></div>

    <!-- Row 1: Search -->
    <div class="mb-4">
      <div class="flex items-end gap-2 md:mr-4">
        <label class="text-xs uppercase tracking-wide text-muted font-medium flex flex-col gap-1">
          Search
          <input
            id="drink-search"
            type="search"
            placeholder="Search drinks..."
            class="w-full md:w-96 rounded border border-fg/30 bg-fg/5 px-3 py-2 text-sm focus:outline-none focus:ring-2"
            autocomplete="off"
          />
        </label>
        <button id="drink-search-clear" class="hidden text-[11px] underline underline-offset-4 hover:text-fg mb-1.5">Clear</button>
        <span id="drink-search-hits" class="text-[11px] text-muted mb-2"></span>
      </div>
    </div>

    <!-- Row 2: Filters -->
    <div class="mb-6">
      <div class="flex flex-wrap gap-2 items-center">
        <span class="text-[11px] uppercase tracking-wide text-muted/70">Filters</span>

        <div class="relative" data-filter-wrapper>
          <button type="button" class="filter-toggle pill pill--soft" data-panel="types" aria-expanded="false">
            Drink Type
          </button>
          <div class="filter-panel hidden" id="panel-types" role="group" aria-label="Drink Type">
            <div class="panel-inner">
              {drinkTypes.map(([t,count]) => (
                <button type="button" class="filter-item pill pill--soft" data-filter-type="type" data-value={t} aria-pressed="false">
                  <span>{t}</span><span class="count">{count}</span>
                </button>
              ))}
            </div>
          </div>
        </div>

        <div class="relative" data-filter-wrapper>
          <button type="button" class="filter-toggle pill pill--soft" data-panel="bases" aria-expanded="false">
            Alcohol Base
          </button>
          <div class="filter-panel hidden" id="panel-bases" role="group" aria-label="Alcohol Base">
            <div class="panel-inner">
              {bases.map(([b,count]) => (
                <button type="button" class="filter-item pill pill--soft" data-filter-type="base" data-value={b.toLowerCase()} data-display={b} aria-pressed="false">
                  <span>{b}</span><span class="count">{count}</span>
                </button>
              ))}
            </div>
          </div>
        </div>

        <div class="relative" data-filter-wrapper>
          <button type="button" class="filter-toggle pill pill--soft" data-panel="difficulty" aria-expanded="false">
            Difficulty
          </button>
          <div class="filter-panel hidden" id="panel-difficulty" role="group" aria-label="Difficulty">
            <div class="panel-inner">
              {difficulties.map(([d,count]) => (
                <button type="button" class="filter-item pill pill--soft" data-filter-type="difficulty" data-value={d} aria-pressed="false">
                  <span>{d}</span><span class="count">{count}</span>
                </button>
              ))}
            </div>
          </div>
        </div>

        <span class="ml-auto"></span>

        <button id="exclusive-toggle" type="button" class="pill pill--soft" aria-pressed="false">
          Exclusive
        </button>
        <button id="clear-filters" type="button" class="pill pill--soft disabled:opacity-40 disabled:cursor-not-allowed" disabled>
          Clear
        </button>

        <span id="result-count" class="text-xs text-muted"></span>
      </div>
    </div>

    {drinks.length === 0 ? (
      <p class="text-muted">No drinks found.</p>
    ) : (
      <ul id="drinks-grid" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5 list-none p-0 m-0">
        {drinks.map(d => (
          <li
            class="relative group"
            data-type={d.drinkType}
            data-bases={d.basesLC.join(',')}
            data-difficulty={d.difficulty}
            data-title={(d.title||'').toLowerCase()}
            data-bases-search={d.basesLC.join(',')}
            data-excerpt={(d.excerpt||'').toLowerCase()}
            data-search-visible="true"
          >
            <div class="glass p-3 relative">
              <div class="flex">
                <picture class="mr-3 shrink-0">
                  <img
                    src={d.image}
                    alt={d.title}
                    loading="lazy"
                    decoding="async"
                    class="w-[88px] h-[88px] object-cover rounded-sm border border-fg/15 bg-fg/5"
                    onerror="this.style.display='none'"
                  />
                </picture>
                <div class="flex flex-col min-w-0">
                  <span class="font-semibold leading-snug mb-1 transition-colors group-hover:text-fg">{d.title}</span>
                  {d.excerpt && <p class="text-xs text-muted leading-snug line-clamp-2 mb-2">{d.excerpt}</p>}
                  <div class="flex flex-wrap gap-2 text-[10px] uppercase tracking-wide font-semibold relative" style="z-index:20">
                    <button class="pill pill--filled tone-magenta js-filter" data-type="type" data-value={d.drinkType} title={`Filter: ${d.drinkType}`}>{d.drinkType}</button>
                    {d.bases.slice(0,3).map(b => <button class="pill pill--filled tone-magenta js-filter" data-type="base" data-value={b.toLowerCase()} title={`Filter: ${b}`}>{b}</button>)}
                    {d.bases.length > 3 && <span class="pill pill--soft">+{d.bases.length - 3}</span>}
                    {d.difficulty && <button class="pill pill--filled tone-magenta js-filter" data-type="difficulty" data-value={d.difficulty} title={`Filter: ${d.difficulty}`}>{d.difficulty}</button>}
                  </div>
                </div>
              </div>
            </div>
            <a href={d.href} aria-label={`View drink: ${d.title}`} class="absolute inset-0 rounded-md" style="z-index:10">
              <span class="sr-only">{d.title}</span>
            </a>
          </li>
        ))}
      </ul>
    )}

    <p class="mt-10 text-sm">
      <a class="hover:underline" href={withBase('/')}>← Back to Home</a>
    </p>
  </div>

  <script type="module" src={withBase('scripts/drinks-filters.js')}></script>

  <script is:inline>
    (() => {
      const input = document.getElementById('drink-search');
      const clear = document.getElementById('drink-search-clear');
      const hitsEl = document.getElementById('drink-search-hits');
      const grid = document.getElementById('drinks-grid');
      if(!input || !grid) return;
      const items = Array.from(grid.children);

      function applySearch(){
        const q = input.value.trim().toLowerCase();
        let hits = 0;
        items.forEach(li => {
          const title = li.getAttribute('data-title') || '';
          const type = li.getAttribute('data-type') || '';
          const bases = li.getAttribute('data-bases-search') || '';
          const diff = li.getAttribute('data-difficulty') || '';
          const excerpt = li.getAttribute('data-excerpt') || '';
          const match = !q || title.includes(q) || type.includes(q) || bases.includes(q) || diff.includes(q) || excerpt.includes(q);
          li.dataset.searchVisible = match ? 'true' : 'false';
          if (match) hits++;
        });
        clear.classList.toggle('hidden', q.length === 0);
        if (hitsEl) hitsEl.textContent = q ? `${hits} match${hits===1?'':'es'}` : '';
        window.bggApplyDrinkFilters?.();
      }

      input.addEventListener('input', applySearch);
      clear.addEventListener('click', () => { input.value=''; applySearch(); input.focus(); });
      applySearch();

      // Card chips to toggle filters
      document.getElementById('drinks-grid')?.addEventListener('click', (e) => {
        const target = e.target;
        if (!(target instanceof HTMLElement)) return;
        const chip = target.closest('.js-filter');
        if (!chip) return;
        const type = chip.getAttribute('data-type');
        const value = chip.getAttribute('data-value');
        if (!type || !value) return;
        window.bggToggleDrinkFilter?.(type, value);
        window.bggApplyDrinkFilters?.();
      });
    })();
  </script>
</Layout>
