---
import Layout from '../../components/Layout.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import FeedbackCard from '../../components/FeedbackCard.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/paths';
import { canonical } from '../../lib/urls';
import { pickImageFile } from '../../lib/images';

const raw = await getCollection('drinks');

type DrinkCard = {
  title: string;
  drinkType: string;
  base: string;
  difficulty: string;
  tags: string[];
  excerpt: string;
  leaf: string;
  image: string;
  href: string;
};

const allDrinks: DrinkCard[] = raw
  .map(d => {
    const full = d.slug ?? d.id;
    const leaf = (full.split('/').pop() || '') as string;
    const drinkType = (d.data.drinkType || 'misc').toString();
    const base = (
      d.data.base ||
      (Array.isArray(d.data.bases) ? d.data.bases[0] : '') ||
      ''
    ).toString();
    const difficulty = (d.data.difficulty || '').toString();
    const tags = Array.isArray(d.data.tags) ? d.data.tags : [];
    const excerpt = (d.data.excerpt || '').toString();
    return {
      title: d.data.title,
      drinkType,
      base,
      difficulty,
      tags,
      excerpt,
      leaf,
      image: withBase(`images/${pickImageFile(leaf)}`),
      href: withBase(`drinks/${leaf}/`),
    };
  })
  .sort((a: DrinkCard, b: DrinkCard) => (a.title || '').localeCompare(b.title || ''));

// Build counts for filters
const typeCounts = new Map<string, number>();
const baseCounts = new Map<string, number>();
const diffCounts = new Map<string, number>();
const tagCounts = new Map<string, number>();
for (const d of allDrinks) {
  typeCounts.set(d.drinkType, (typeCounts.get(d.drinkType) || 0) + 1);
  if (d.base) baseCounts.set(d.base, (baseCounts.get(d.base) || 0) + 1);
  if (d.difficulty) diffCounts.set(d.difficulty, (diffCounts.get(d.difficulty) || 0) + 1);
  for (const t of d.tags) tagCounts.set(t, (tagCounts.get(t) || 0) + 1);
}

const drinkTypes = Array.from(typeCounts.entries()).sort((a, b) => a[0].localeCompare(b[0]));
const bases = Array.from(baseCounts.entries()).sort((a, b) => a[0].localeCompare(b[0]));
const difficulties = Array.from(diffCounts.entries()).sort((a, b) => a[0].localeCompare(b[0]));
const tags = Array.from(tagCounts.entries()).sort((a, b) => a[0].localeCompare(b[0]));

const pageCanonical = canonical(Astro.url.pathname, Astro.site);
---

<Layout
  title="Drinks"
  description="All drinks, cocktails, and shots. Filter by Drink Type, alcohol base, difficulty, or tags."
  canonical={pageCanonical}
  wide={true}
>
  <div class="tone-magenta">
    <h1 class="tone-magenta-text mb-4 font-display text-4xl">Drinks</h1>
    <p class="mb-5 text-sm text-muted">
      Explore cocktails, shots, and more. Use search and filters, or pick a
      <a class="underline underline-offset-4 hover:text-fg" href={withBase('drinks/random')}
        >Random Drink</a
      >
    </p>

    <div class="divider" aria-hidden="true"></div>

    <!-- Row 1: Search -->
    <div class="mb-4">
      <div class="flex items-end gap-2 md:mr-4">
        <label class="flex flex-col gap-1 text-xs font-medium tracking-wide text-muted">
          <span>Search</span>
          <input
            id="drink-search"
            type="search"
            placeholder="Search drinks..."
            class="w-full rounded border border-fg/30 bg-fg/5 px-3 py-2 text-sm focus:outline-none focus:ring-2 md:w-96"
            autocomplete="off"
          />
        </label>
      </div>
    </div>

    <!-- Row 2: Filters -->
    <div class="mb-6">
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-[11px] uppercase tracking-wide text-muted/70">Filters</span>

        <!-- Drink Type -->
        <div class="relative" data-filter-wrapper>
          <button
            type="button"
            class="filter-toggle pill pill--soft"
            data-panel="drinktype"
            data-filter-group="drinkType"
            aria-expanded="false"
            aria-pressed="false"
          >
            Drink Type
          </button>
          <div
            class="filter-panel hidden"
            id="panel-drinktype"
            role="group"
            aria-label="Drink Type"
          >
            <div class="panel-inner">
              {
                drinkTypes.map(([t, count]) => (
                  <button
                    type="button"
                    class="filter-item pill pill--soft"
                    data-filter-type="drinkType"
                    data-value={t}
                    aria-pressed="false"
                  >
                    <>
                      <span>{t}</span>
                      <span class="count">{count}</span>
                    </>
                  </button>
                ))
              }
            </div>
          </div>
        </div>

        <!-- Alcohol base -->
        <div class="relative" data-filter-wrapper>
          <button
            type="button"
            class="filter-toggle pill pill--soft"
            data-panel="bases"
            data-filter-group="base"
            aria-expanded="false"
            aria-pressed="false"
          >
            Alcohol base
          </button>
          <div class="filter-panel hidden" id="panel-bases" role="group" aria-label="Alcohol base">
            <div class="panel-inner">
              {
                bases.map(([b, count]) => (
                  <button
                    type="button"
                    class="filter-item pill pill--soft"
                    data-filter-type="base"
                    data-value={b}
                    aria-pressed="false"
                  >
                    <>
                      <span>{b}</span>
                      <span class="count">{count}</span>
                    </>
                  </button>
                ))
              }
            </div>
          </div>
        </div>

        <!-- Difficulty -->
        <div class="relative" data-filter-wrapper>
          <button
            type="button"
            class="filter-toggle pill pill--soft"
            data-panel="difficulty"
            data-filter-group="difficulty"
            aria-expanded="false"
            aria-pressed="false"
          >
            Difficulty
          </button>
          <div
            class="filter-panel hidden"
            id="panel-difficulty"
            role="group"
            aria-label="Difficulty"
          >
            <div class="panel-inner">
              {
                difficulties.map(([level, count]) => (
                  <button
                    type="button"
                    class="filter-item pill pill--soft"
                    data-filter-type="difficulty"
                    data-value={level}
                    aria-pressed="false"
                  >
                    <>
                      <span>{level}</span>
                      <span class="count">{count}</span>
                    </>
                  </button>
                ))
              }
            </div>
          </div>
        </div>

        <!-- Tags (solid + high z-index to sit above card chips) -->
        <div class="relative" data-filter-wrapper>
          <button
            type="button"
            class="filter-toggle pill pill--soft"
            data-panel="tags"
            data-filter-group="tag"
            aria-expanded="false"
            aria-pressed="false"
            id="tags-toggle"
          >
            Tags
          </button>
          <div
            class="filter-panel filter-panel--solid hidden"
            id="panel-tags"
            role="group"
            aria-label="Tags"
            style="
              z-index: 1200 !important;
              background: rgb(var(--bg-rgb)) !important;
              background-image: none !important;
              -webkit-backdrop-filter: none !important;
              backdrop-filter: none !important;
              filter: none !important;
              opacity: 1 !important;
              mix-blend-mode: normal !important;
              border: 1px solid rgba(255,255,255,0.18) !important;
              box-shadow: 0 10px 24px rgba(0,0,0,0.55) !important;
            "
          >
            <div class="panel-inner">
              {
                tags.map(([t, count]) => (
                  <button
                    type="button"
                    class="filter-item pill pill--soft"
                    data-filter-type="tag"
                    data-value={t}
                    aria-pressed="false"
                  >
                    <>
                      <span>{t}</span>
                      <span class="count">{count}</span>
                    </>
                  </button>
                ))
              }
            </div>
          </div>
        </div>

        <!-- Exclusive, Clear, and mobile result count -->
        <div class="mt-2 flex w-full items-center gap-3 sm:mt-0 sm:w-auto">
          <a href="#" id="exclusive-toggle" class="filter-link" aria-pressed="false">
            <span class="dot" aria-hidden="true"></span>
            Exclusive
          </a>
          <a href="#" id="clear-filters" class="filter-link text-muted" aria-disabled="true">
            Clear
          </a>
          <span id="result-count-mobile" class="ml-auto text-xs text-muted sm:hidden"></span>
        </div>

        <!-- Desktop/tablet result count on far right -->
        <span id="result-count" class="ml-auto hidden text-xs text-muted sm:inline"></span>
      </div>
    </div>

    {
      allDrinks.length === 0 ? (
        <p class="text-muted">No drinks found.</p>
      ) : (
        <ul
          id="drink-grid"
          class="m-0 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-3 2xl:grid-cols-3"
        >
          {allDrinks.map(d => {
            const panelId = `tags-${d.leaf}`;
            return (
              <li
                class="drink-card group relative"
                data-drinktype={d.drinkType.toLowerCase()}
                data-base={d.base.toLowerCase()}
                data-difficulty={d.difficulty.toLowerCase()}
                data-tags={d.tags.join(',').toLowerCase()}
                data-title={(d.title || '').toLowerCase()}
                data-excerpt={(d.excerpt || '').toLowerCase()}
                data-search-visible="true"
              >
                <div class="glass relative p-3">
                  <div class="flex">
                    <picture class="mr-3 shrink-0">
                      <img
                        src={d.image}
                        alt={d.title}
                        loading="lazy"
                        decoding="async"
                        class="h-[88px] w-[88px] rounded-sm border border-fg/15 bg-fg/5 object-cover"
                        data-fb-key={d.leaf}
                      />
                    </picture>
                    <div class="flex min-w-0 flex-col">
                      <span class="mb-1 font-semibold leading-snug transition-colors group-hover:text-fg">
                        {d.title}
                      </span>
                      {d.excerpt && (
                        <p class="mb-2 line-clamp-2 text-xs leading-snug text-muted">{d.excerpt}</p>
                      )}

                      {/* Chips row */}
                      <div
                        class="chip-row flex flex-wrap gap-2 text-[11px] font-semibold tracking-wide"
                        style="position: relative; z-index: 60;"
                      >
                        <button
                          type="button"
                          class="pill pill--filled tone-magenta js-card-chip"
                          data-chip-type="drinkType"
                          data-chip-value={d.drinkType}
                          aria-pressed="false"
                          title={`Filter: ${d.drinkType}`}
                        >
                          {d.drinkType}
                        </button>

                        {d.base && (
                          <button
                            type="button"
                            class="pill pill--filled tone-magenta js-card-chip"
                            data-chip-type="base"
                            data-chip-value={d.base}
                            aria-pressed="false"
                            title={`Filter: ${d.base}`}
                          >
                            {d.base}
                          </button>
                        )}

                        {d.difficulty && (
                          <button
                            type="button"
                            class="pill pill--filled tone-magenta js-card-chip"
                            data-chip-type="difficulty"
                            data-chip-value={d.difficulty}
                            aria-pressed="false"
                            title={`Filter: ${d.difficulty}`}
                          >
                            {d.difficulty}
                          </button>
                        )}

                        {d.tags.length > 0 && (
                          <div class="relative inline-block" data-card-tags>
                            <button
                              type="button"
                              class="pill pill--filled tone-magenta"
                              aria-haspopup="listbox"
                              aria-expanded="false"
                              aria-controls={panelId}
                              data-open-card-tags
                              title="Show tags for this drink"
                            >
                              {d.tags.length} tag{d.tags.length !== 1 && 's'}
                            </button>
                            <div
                              class="filter-panel narrow"
                              id={panelId}
                              role="group"
                              aria-label={`Tags for ${d.title}`}
                              data-card-tags-panel
                              style="position: absolute; z-index: 55; display: none; right: 0; left: auto;"
                            >
                              <div class="panel-inner panel-inner-col">
                                {d.tags.map((t: string) => (
                                  <button
                                    type="button"
                                    class="filter-item pill pill--soft block w-full justify-between text-left"
                                    data-filter-type="tag"
                                    data-value={t}
                                    aria-pressed="false"
                                  >
                                    <span>{t}</span>
                                  </button>
                                ))}
                              </div>
                            </div>
                          </div>
                        )}
                      </div>
                    </div>
                  </div>
                </div>

                <a
                  href={d.href}
                  aria-label={`View drink: ${d.title}`}
                  class="overlay-link absolute inset-0 rounded-md"
                  data-card-link
                >
                  <span class="sr-only">{d.title}</span>
                </a>
              </li>
            );
          })}
        </ul>
      )
    }

    <!-- Share and Feedback (no extra headings) -->
    <div class="mt-12">
      <ShareButtons url={pageCanonical} title="Drinks" />
      <FeedbackCard />
    </div>
  </div>

  <style is:inline>
    /* Card lift */
    .drink-card:hover > .glass,
    .drink-card:focus-within > .glass {
      transform: translateY(-2px);
      border-color: rgba(255, 255, 255, 0.18);
      box-shadow:
        0 22px 44px rgba(0, 0, 0, 0.4),
        inset 0 1px 0 rgba(255, 255, 255, 0.08);
    }

    .drink-card {
      cursor: pointer;
    }
    .drink-card > a.overlay-link {
      pointer-events: none;
    }

    .filter-toggle,
    #exclusive-toggle,
    #clear-filters {
      text-transform: none !important;
    }

    /* Top filter dropdowns: drop to the right (attach left edge) and sit above chips */
    [data-filter-wrapper] .filter-panel {
      left: 0;
      right: auto;
      width: max-content;
      max-width: min(92vw, 320px);
      z-index: 1200; /* ensure above chip rows (z:60) */
    }
    /* Per-card tags dropdown: drop to the left (attach right edge) and stay under chip row */
    [data-card-tags] [data-card-tags-panel] {
      right: 0;
      left: auto;
      width: max-content;
      max-width: min(90vw, 260px);
      z-index: 55;
    }

    /* Opaque per-card tags panel (fallback in case global CSS not loaded yet) */
    [data-card-tags-panel] {
      background-color: var(--bg) !important;
      background-image: none !important;
      -webkit-backdrop-filter: none !important;
      backdrop-filter: none !important;
      filter: none !important;
      mix-blend-mode: normal !important;
      border: 1px solid rgba(255, 255, 255, 0.18) !important;
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.55) !important;
    }
    [data-card-tags-panel] .panel-inner {
      background: transparent !important;
      border: 0 !important;
      box-shadow: none !important;
    }

    /* Link-style controls */
    .filter-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      text-decoration: none;
      cursor: pointer;
      font-size: 0.75rem;
      line-height: 1;
      padding: 4px 0;
    }
    #clear-filters[aria-disabled='true'] {
      color: rgba(255, 255, 255, 0.5);
      pointer-events: none;
      cursor: default;
    }

    /* Exclusive status dot: red when off, green when on */
    #exclusive-toggle .dot {
      width: 8px;
      height: 8px;
      border-radius: 9999px;
      background: #c33;
      box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.25) inset;
      transition: background-color 0.15s ease-in-out;
    }
    #exclusive-toggle[aria-pressed='true'] .dot {
      background: #16a34a;
    }

    /* Bring active drink card above neighbors so its dropdown is on top */
    .drink-card.on-top {
      z-index: 4000;
      position: relative;
    }
  </style>

  <script type="module" src={withBase('scripts/drinks-filters.js')}></script>
  <script type="module" src={withBase('scripts/drinks-ui.js')}></script>
</Layout>
