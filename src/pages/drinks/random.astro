---
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/paths';

const drinks = await getCollection('drinks');
const leaves = Array.from(new Set(drinks.map(d => d.id.split('/').pop())));
const fullPaths = leaves.map(l => withBase(`drinks/${l}/`));
const fallback = withBase('drinks/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Random Drink</title>
    <meta name="robots" content="noindex" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <style>
      :root {
        color-scheme: dark;
      }
      html,
      body {
        height: 100%;
        margin: 0;
        background: #000;
        color: #fff;
        font:
          15px/1.4 system-ui,
          -apple-system,
          Segoe UI,
          Roboto,
          sans-serif;
      }
      .center {
        min-height: 100%;
        display: grid;
        place-items: center;
      }
      .wrap {
        text-align: center;
      }
      .icon {
        width: 76px;
        height: 76px;
        border-radius: 18px;
        border: 1px solid rgba(255, 255, 255, 0.18);
        display: grid;
        place-items: center;
        background: rgba(255, 255, 255, 0.04);
        box-shadow:
          0 12px 34px -8px rgba(0, 0, 0, 0.65),
          inset 0 1px 0 rgba(255, 255, 255, 0.06);
        animation: spin 1.05s linear infinite;
        margin: 0 auto;
      }
      .icon svg {
        width: 38px;
        height: 38px;
        stroke: #ff0080;
      }
      .label {
        margin-top: 16px;
        font:
          600 12px/1.15 system-ui,
          -apple-system,
          Segoe UI,
          Roboto,
          sans-serif;
        color: #9aa4ad;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      @keyframes spin {
        from {
          transform: rotate(0deg);
        }
        to {
          transform: rotate(360deg);
        }
      }
      a.fallback {
        color: #ff0080;
        text-decoration: none;
      }
      a.fallback:hover {
        text-decoration: underline;
      }
    </style>
  </head>
  <body>
    <div class="center">
      <div class="wrap">
        <div class="icon" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M3 4h18l-8.5 8.5v5.5l3 2H8l3-2v-5.5L3 4Z"></path><path d="M10 4l4 4"></path>
          </svg>
        </div>
        <div class="label">Pouring a drink…</div>
        <noscript>
          <p style="margin-top:14px">
            <a class="fallback" href={fallback}>Browse drinks</a>
          </p>
        </noscript>
      </div>
    </div>
    <script is:inline define:vars={{ fullPaths, fallback }}>
      (function () {
        function redirect() {
          const target = fullPaths.length
            ? fullPaths[Math.floor(Math.random() * fullPaths.length)]
            : fallback;
          location.replace(target);
        }

        let timer = setTimeout(redirect, 2000);
        window.addEventListener('pagehide', () => clearTimeout(timer));
        window.addEventListener('pageshow', event => {
          if (event.persisted) {
            clearTimeout(timer);
            timer = setTimeout(redirect, 2000);
          }
        });
      })();
    </script>
  </body>
</html>
