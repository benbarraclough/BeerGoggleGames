---
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/paths';

const drinks = await getCollection('drinks');
const leaves = Array.from(new Set(drinks.map(d => (d.slug ?? d.id).split('/').pop())));
const fullPaths = leaves.map(l => withBase(`drinks/${l}/`));
const pick = fullPaths.length ? fullPaths[Math.floor(Math.random() * fullPaths.length)] : null;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Random Drink</title>
    <meta name="robots" content="noindex" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <style>
      :root { color-scheme: dark; }
      html,body { height:100%; margin:0; background:#000; color:#fff; }
      .center { min-height:100%; display:grid; place-items:center; }
      .wrap { text-align:center; }
      .icon {
        width:72px; height:72px; border-radius:16px; border:1px solid rgba(255,255,255,.2);
        display:grid; place-items:center; background:rgba(255,255,255,.04);
        box-shadow: 0 10px 30px rgba(0,0,0,.5), inset 0 1px 0 rgba(255,255,255,.06);
        animation: spin 1.2s linear infinite;
      }
      .icon svg { width:34px; height:34px; stroke:#f0f; }
      .label { margin-top:14px; font: 600 12px/1.2 system-ui, -apple-system, Segoe UI, Roboto, sans-serif; color:#9aa4ad; letter-spacing:.08em; text-transform:uppercase;}
      @keyframes spin { from { transform: rotate(0deg) } to { transform: rotate(360deg) } }
    </style>
  </head>
  <body>
    <div class="center">
      <div class="wrap">
        <div class="icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 4h18l-8.5 8.5v5.5l3 2H8l3-2v-5.5L3 4Z"/><path d="M10 4l4 4"/>
          </svg>
        </div>
        <div class="label">Pouring a drink…</div>
        <noscript><p style="margin-top:10px"><a href={pick ?? withBase('drinks/')} style="color:#f0f">Click to continue</a></p></noscript>
      </div>
    </div>
    <script>
      (function(){
        var p = {pick: ${JSON.stringify(pick)}};
        if (!p.pick) { location.href = ${JSON.stringify(withBase('drinks/'))}; return; }
        setTimeout(function(){ location.replace(p.pick); }, 1500);
      })();
    </script>
  </body>
</html>
