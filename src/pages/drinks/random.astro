---
import { getCollection } from 'astro:content';
import Layout from '../../components/Layout.astro';
import { withBase } from '../../lib/paths';

const pageTitle = 'Random Drink';
const description = 'Redirecting you to a random drink.';

const drinks = await getCollection('drinks');
const leaves = Array.from(new Set(drinks.map(d => (d.slug ?? d.id).split('/').pop())));
const fullPaths = leaves.map(l => withBase(`drinks/${l}/`));
const fallback = fullPaths.length ? fullPaths[Math.floor(Math.random() * fullPaths.length)] : null;
---
<Layout title={pageTitle} description={description} noindex={true}>
  <h1 class="font-display text-3xl mb-4">{pageTitle}</h1>

  {fullPaths.length === 0 ? (
    <p class="text-muted">No drinks available.</p>
  ) : (
    <>
      <div class="glass p-6 max-w-md">
        <p class="text-sm text-muted mb-4">Picking a random drink…</p>
        <div class="grid grid-cols-5 gap-2" id="icon-grid" aria-hidden="true">
          {Array.from({length:15}).map((_,i)=>(
            <div class="h-8 rounded border border-fg/15 bg-fg/5 flex items-center justify-center text-xs">🍹</div>
          ))}
        </div>
      </div>

      <p class="text-xs text-muted mt-4">
        If nothing happens (e.g. JavaScript disabled), use the list below.
      </p>

      <noscript>
        <div class="mt-5">
          {fallback && (
            <p class="mb-4">
              <a class="underline hover:text-neon" href={fallback}>
                Go to a random drink
              </a>
            </p>
          )}
          <ul class="columns-2 gap-6 text-xs list-none p-0 m-0">
            {fullPaths.slice(0, 40).map(p => (
              <li class="mb-1">
                <a class="hover:text-neon underline underline-offset-4" href={p}>
                  {p.replace(/.*drinks\//, '').replace(/\/$/, '')}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </noscript>

      <script is:inline>
        (function(){
          try{
            var paths = ${JSON.stringify(fullPaths)};
            if(!paths.length) return;
            var last; try{ last = sessionStorage.getItem('lastRandomDrink'); }catch(_){}
            var pick = paths[Math.floor(Math.random()*paths.length)];
            if(paths.length>1 && pick===last){ pick = paths[Math.floor(Math.random()*paths.length)]; }
            try{ sessionStorage.setItem('lastRandomDrink', pick); }catch(_){}
            // Tiny icon shimmer before redirect
            var cells = Array.from(document.querySelectorAll('#icon-grid > div'));
            var t = 0; var interval = setInterval(function(){
              cells.forEach((c,idx)=>{ c.style.opacity = (idx%3===t%3)? '1' : '0.4'; });
              t++;
            }, 120);
            setTimeout(function(){ clearInterval(interval); window.location.replace(pick); }, 1800);
          }catch(e){ console.error('Random redirect failed', e); }
        })();
      </script>
    </>
  )}
</Layout>
