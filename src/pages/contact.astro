---
import Layout from '../components/Layout.astro';
import { withBase } from '../lib/paths';
---
<Layout title="Contact" description="Send feedback, suggestions or corrections.">
  <h1 class="font-display text-3xl md:text-4xl mb-3">Contact</h1>

  <div class="divider" aria-hidden="true"></div>

  <section class="glass p-5 tone-green max-w-xl">
    <form action="https://formspree.io/f/xkgzldbg" method="POST" class="grid gap-3">
      <label class="grid gap-1">
        <span class="text-sm text-muted">Email</span>
        <input class="bg-fg/5 border border-fg/30 px-3 py-2 rounded focus:outline-none focus:border-neon" type="email" name="email" required />
      </label>
      <label class="grid gap-1">
        <span class="text-sm text-muted">Message</span>
        <textarea class="bg-fg/5 border border-fg/30 px-3 py-2 rounded focus:outline-none focus:border-neon" name="message" rows="6" required></textarea>
      </label>
      <button class="justify-self-start px-4 py-2 rounded border border-fg/25 bg-fg/10 hover:border-neon hover:text-neon text-sm font-medium" type="submit">
        Send
      </button>
    </form>
    <p class="mt-3 text-xs text-muted">Submissions go to BeerGoggleGames@hotmail.com.</p>
  </section>

  <p class="mt-6 text-sm">
    <a class="hover:text-neon underline underline-offset-4" href={withBase('')}>← Back to Home</a>
  </p>
</Layout>
