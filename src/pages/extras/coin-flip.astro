---
import Layout from '../../components/Layout.astro';
import BackLink from '../../components/BackLink.astro';
import { withBase } from '../../lib/paths';
import ShareButtons from '../../components/ShareButtons.astro';
import FeedbackCard from '../../components/FeedbackCard.astro';

const title = 'Coin Flip';
const description = 'Flip a more realistic on-screen coin with smooth shading.';
---

<Layout title={title} description={description}>
  <header class="tone-green mb-6">
    <h1 class="tone-green-text mb-2 font-display text-3xl md:text-4xl">{title}</h1>
    <p class="text-muted">{description}</p>
  </header>

  <div class="divider" aria-hidden="true"></div>

  <section class="glass tone-green mx-auto max-w-xl p-6">
    <p class="mb-3 text-sm text-muted">Flip a single coin with realistic lighting and easing.</p>
    <div class="relative mx-auto aspect-square w-full max-w-[360px]">
      <canvas id="coin" class="h-full w-full rounded-md border border-fg/15 bg-bg"></canvas>
    </div>
    <div class="mt-4 flex items-center justify-center gap-3">
      <button
        id="flip-coin"
        type="button"
        class="rounded border border-fg/25 bg-fg/10 px-4 py-2 text-sm font-medium hover:border-fg/50"
      >
        Flip
      </button>
      <div id="coin-result" class="min-h-[1.75rem] text-sm font-semibold text-muted"></div>
    </div>
  </section>

  <ShareButtons title={title} />
  <FeedbackCard>
    <p>Want streaks, weighted flips, or multiple coins? Let us know.</p>
  </FeedbackCard>

  <BackLink href={withBase('extras/')} label="Back to Extras" />

  <script type="module" src={withBase('scripts/coin.js')}></script>
</Layout>
