---
import Layout from '../../components/Layout.astro';
import BackLink from '../../components/BackLink.astro';
import { withBase } from '../../lib/paths';
import ShareButtons from '../../components/ShareButtons.astro';
import FeedbackCard from '../../components/FeedbackCard.astro';

const title = 'Dice Roller';
const description = 'Roll one or more monochrome dice with a smooth animation and running total.';
---

<Layout title={title} description={description}>
  <header class="tone-green mb-6">
    <h1 class="tone-green-text mb-2 font-display text-3xl md:text-4xl">{title}</h1>
    <p class="text-muted">{description}</p>
  </header>

  <div class="divider" aria-hidden="true"></div>

  <section class="glass tone-green mx-auto max-w-3xl p-6">
    <div class="mb-3 flex flex-wrap items-end justify-center gap-3">
      <label class="flex flex-col gap-1 text-xs font-medium uppercase tracking-wide text-muted">
        Dice
        <select
          id="dice-count"
          class="w-28 rounded border border-fg/25 bg-fg/10 px-3 py-2 text-sm focus:outline-none focus:ring-2"
        >
          {Array.from({ length: 6 }, (_, i) => i + 1).map(n => <option value={n}>{n}</option>)}
        </select>
      </label>
      <button
        id="roll-dice"
        type="button"
        class="rounded border border-fg/25 bg-fg/10 px-4 py-2 text-sm font-medium hover:border-fg/50"
      >
        Roll
      </button>
      <div id="dice-result" class="min-h-[1.75rem] text-sm font-semibold text-muted"></div>
    </div>

    <div class="relative mx-auto aspect-[3/2] w-full max-w-[640px]">
      <canvas id="dice" class="h-full w-full rounded-md border border-fg/15 bg-bg"></canvas>
    </div>
  </section>

  <ShareButtons title={title} />
  <FeedbackCard>
    <p>Need modifiers, advantage/disadvantage or custom dice? Tell us what you need.</p>
  </FeedbackCard>

  <BackLink href={withBase('extras/')} label="Back to Extras" />

  <script type="module" src={withBase('scripts/dice.js')}></script>
</Layout>
