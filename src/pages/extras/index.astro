---
import Layout from '../../components/Layout.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import FeedbackCard from '../../components/FeedbackCard.astro';
import { withBase } from '../../lib/paths';

const title = 'Extras';
const description =
  'Tools and extras: quick utilities and bonus content to level up your sessions.';
const tools = [
  {
    href: withBase('extras/wheel-of-fortune/'),
    title: 'Wheel of Fortune',
    desc: 'Spin categories & games.',
    img: withBase('images/wheel.webp'),
  },
  {
    href: withBase('extras/dice/'),
    title: 'Dice Roller',
    desc: 'Animated on-screen dice.',
    img: withBase('images/dice.webp'),
  },
  {
    href: withBase('extras/coin-flip/'),
    title: 'Coin Flip',
    desc: 'Animated coin flip.',
    img: withBase('images/coin.webp'),
  },
];
const bonus = [
  {
    href: withBase('extras/forfeits/'),
    title: 'Forfeits',
    desc: 'Creative penalties & challenges.',
    img: withBase('images/forfeits.webp'),
  },
  {
    href: withBase('extras/glossary/'),
    title: 'Glossary',
    desc: 'Drinking terms explained.',
    img: withBase('images/glossary.webp'),
  },
  {
    href: withBase('extras/activities/'),
    title: 'Activities',
    desc: 'Party & social activities.',
    img: withBase('images/activities.webp'),
  },
];
---

<Layout title={title} description={description}>
  <header class="tone-green mb-6">
    <h1 class="tone-green-text mb-2 font-display text-3xl md:text-4xl">{title}</h1>
    <p class="text-muted">{description}</p>
  </header>

  <div class="divider" aria-hidden="true"></div>

  <section class="tone-green mt-8">
    <h2 class="tone-green-text mb-3 font-display text-xl md:text-2xl">Tools</h2>
    <ul class="m-0 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
      {
        tools.map(l => (
          <li class="glass group relative overflow-hidden p-5">
            <div
              class="absolute inset-0 -z-[1] bg-cover bg-center opacity-35 transition-opacity duration-200 group-hover:opacity-45"
              style={`background-image:url('${l.img}')`}
              aria-hidden="true"
            />
            <div class="relative flex flex-col gap-2">
              <span class="font-semibold group-hover:text-fg">{l.title}</span>
              <span class="text-xs leading-snug text-muted">{l.desc}</span>
              <span class="tone-green-text text-[11px] font-medium uppercase">Open →</span>
            </div>
            <a
              href={l.href}
              class="absolute inset-0 rounded-md focus-visible:outline-none focus-visible:ring-2"
              aria-label={l.title}
            >
              <span class="sr-only">{l.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="tone-green mt-10">
    <h2 class="tone-green-text mb-3 font-display text-xl md:text-2xl">Bonus Content</h2>
    <ul class="m-0 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
      {
        bonus.map(l => (
          <li class="glass group relative overflow-hidden p-5">
            <div
              class="absolute inset-0 -z-[1] bg-cover bg-center opacity-35 transition-opacity duration-200 group-hover:opacity-45"
              style={`background-image:url('${l.img}')`}
              aria-hidden="true"
            />
            <div class="relative flex flex-col gap-2">
              <span class="font-semibold group-hover:text-fg">{l.title}</span>
              <span class="text-xs leading-snug text-muted">{l.desc}</span>
              <span class="tone-green-text text-[11px] font-medium uppercase">Open →</span>
            </div>
            <a
              href={l.href}
              class="absolute inset-0 rounded-md focus-visible:outline-none focus-visible:ring-2"
              aria-label={l.title}
            >
              <span class="sr-only">{l.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Share and Feedback (no extra headings) -->
  <div class="mt-12">
    <ShareButtons title="Extras" />
    <FeedbackCard />
  </div>
</Layout>
