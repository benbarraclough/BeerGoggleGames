---
import Layout from '../../components/Layout.astro';
import { withBase } from '../../lib/paths';

const title = 'Extras';
const description = 'Tools and extras: wheel, forfeits, glossary, dice & coin, activities and blog.';
const links = [
  { href: withBase('extras/wheel-of-fortune/'), title: 'Wheel of Fortune', desc: 'Spin categories & games.' },
  { href: withBase('extras/forfeits/'), title: 'Forfeits', desc: 'Creative penalties & challenges.' },
  { href: withBase('extras/glossary/'), title: 'Glossary', desc: 'Drinking terms explained.' },
  { href: withBase('extras/dice/'), title: 'Dice Roller', desc: 'Animated on-screen dice.' },
  { href: withBase('extras/coin-flip/'), title: 'Coin Flip', desc: 'Animated coin flip.' },
  { href: withBase('extras/activities/'), title: 'Activities', desc: 'Party & social activities.' },
  { href: withBase('extras/blog/'), title: 'Blog', desc: 'Guides, announcements & ideas.' },
];
---
<Layout title={title} description={description}>
  <header class="mb-8">
    <h1 class="font-display text-3xl md:text-4xl mb-2">{title}</h1>
    <p class="text-muted">{description}</p>
  </header>

  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 list-none p-0 m-0">
    {links.map(l => (
      <li class="group relative border border-fg/15 rounded p-5 hover:border-neon transition-colors bg-fg/5/10">
        <div class="flex flex-col gap-2">
          <span class="font-semibold group-hover:text-neon">{l.title}</span>
          <span class="text-xs text-muted leading-snug">{l.desc}</span>
          <span class="text-[11px] font-medium uppercase text-neon/80 group-hover:text-neon">Open →</span>
        </div>
        <a href={l.href} class="absolute inset-0 rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neon" aria-label={l.title}>
          <span class="sr-only">{l.title}</span>
        </a>
      </li>
    ))}
  </ul>
</Layout>
