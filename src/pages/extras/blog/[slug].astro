---
import Layout from '../../../components/Layout.astro';
import BackLink from '../../../components/BackLink.astro';
import StructuredData from '../../../components/StructuredData.astro';
import ShareButtons from '../../../components/ShareButtons.astro';
import FeedbackCard from '../../../components/FeedbackCard.astro';
import { withBase } from '../../../lib/paths';
import { canonical } from '../../../lib/urls';
import { postLD } from '../../../lib/schema';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(entry => ({
    params: { slug: entry.slug.split('/').pop() },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const title = entry.data.title;
const description = entry.data.excerpt || entry.data.description || `Post: ${title}.`;
const date = entry.data.date;
const pageCanonical = canonical(Astro.url.pathname, Astro.site);
const ld = postLD({ title, description, url: pageCanonical, date });
---
<Layout title={title} description={description} canonical={pageCanonical}>
  <article class="prose prose-invert max-w-none tone-green">
  <h1 class="font-display text-4xl mb-3 tone-green-text">{title}</h1>
  {date && <p class="text-xs text-muted !mt-0 mb-5">{new Date(date).toISOString().slice(0,10)}</p>}

  <!-- Inject overview wrapper around initial paragraphs until first heading/blockquote/list -->
  <Content />

    <div class="share-wrap">
      <ShareButtons title={title} />
    </div>
    <FeedbackCard />
  </article>

  <BackLink href={withBase('extras/blog/')} label="Back to Blog" />

  <!-- Add icons before section headings using inline SVGs -->
  <script is:inline>
    (function(){
      function svg(name){
        switch(name){
          case 'info': return `<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='9'/><path d='M12 8h.01'/><path d='M12 12v4'/></svg>`;
          case 'tools': return `<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M14.7 6.3a4 4 0 1 0-5.66 5.66l8 8a2 2 0 0 0 2.83-2.83l-8-8Z'/><path d='M5 13l-3 3 3 3 3-3'/><path d='M7 11l-2 2'/></svg>`;
          case 'settings': return `<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z'/><path d='M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06A2 2 0 1 1 7.04 3.3l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06A2 2 0 1 1 20.7 7.04l-.06.06a1.65 1.65 0 0 0-.33 1.82V9c0 .66.26 1.3.73 1.77.47.47 1.11.73 1.77.73H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z'/></svg>`;
          case 'target': return `<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='9'/><circle cx='12' cy='12' r='3'/><path d='M12 3v3M21 12h-3M12 21v-3M3 12h3'/></svg>`;
          case 'howto': return `<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M4 19.5A2.5 2.5 0 0 1 6.5 17H20'/><path d='M20 22H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20Z'/><path d='M8 7h8M8 11h6'/></svg>`;
          case 'rules': return `<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M5 4h14v16H5z'/><path d='M9 8h6M9 12h6M9 16h6'/></svg>`;
          case 'tips': return `<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M9 18h6M10 22h4'/><path d='M2 12h2M20 12h2M12 2v2M4.93 4.93l1.41 1.41M17.66 4.93l-1.41 1.41'/><path d='M12 8a4 4 0 0 1 4 4c0 1.5-.5 2.5-1.5 3.5-.7.7-1 1.5-1 2.5h-3c0-1-.3-1.8-1-2.5C8.5 14.5 8 13.5 8 12a4 4 0 0 1 4-4Z'/></svg>`;
          case 'special': return `<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M12 2 3 7v10l9 5 9-5V7l-9-5Z'/><path d='M12 8v8M8 12h8'/></svg>`;
        }
      }
      const map = [
        { re: /(overview|about)/i, icon: 'info' },
        { re: /(equipment|items|gear|tools|requirements)/i, icon: 'tools' },
        { re: /(setup|prepare|start)/i, icon: 'settings' },
        { re: /(aim|goal|objective|target)/i, icon: 'target' },
        { re: /(how to|play|steps|instructions|method|recipe)/i, icon: 'howto' },
        { re: /(rules?|guidelines|dos|donts)/i, icon: 'rules' },
        { re: /(tips|advice|hints|notes|top tips)/i, icon: 'tips' },
        { re: /(special|variants|edition|extras?)/i, icon: 'special' }
      ];
      function matchIcon(text){
        for (const m of map) if (m.re.test(text)) return m.icon;
        return null;
      }
      document.querySelectorAll('article h2, article h3').forEach(h => {
        if (h.querySelector('.section-icon')) return;
        const icon = matchIcon(h.textContent || '');
        if (!icon) return;
        const span = document.createElement('span');
        span.className = 'section-icon inline-flex w-9 h-9 items-center justify-center rounded-lg bg-fg/5 border border-fg/15 mr-2 align-middle';
        const color = icon === 'special' ? 'text-yellow-400' : 'text-fg/80';
        span.innerHTML = `<span class="w-5 h-5 ${color}" aria-hidden="true">${svg(icon)}</span>`;
        h.prepend(span);
      });
    })();
  </script>

  <StructuredData data={ld} />
</Layout>

<style>
/* Blog-like presentation tweaks */
article.prose{--tw-prose-headings:inherit}
/* Treat the first image in content as a hero */
article.prose > :first-child img{display:block;width:100%;height:auto;border-radius:0.75rem;margin-top:0.25rem;margin-bottom:1rem}
/* Overview box: group leading paragraphs (JS will wrap them) */
.post-overview{
  background: radial-gradient(circle at 15% 15%, color-mix(in oklab, currentColor 12%, transparent), transparent 70%),
              linear-gradient(135deg, color-mix(in oklab, currentColor 8%, transparent), transparent 60%);
  border:1px solid color-mix(in oklab, currentColor 18%, transparent);
  border-left:5px solid color-mix(in oklab, currentColor 40%, transparent);
  padding:1rem 1.05rem .85rem; border-radius:.9rem; margin:-.25rem 0 1.4rem;
  position:relative; overflow:hidden;
}
.post-overview::before{
  content:"Overview"; position:absolute; top:.55rem; right:.75rem; font-size:.65rem; letter-spacing:.12em; text-transform:uppercase;
  padding:.25rem .5rem; border:1px solid color-mix(in oklab, currentColor 25%, transparent); border-radius:.35rem; opacity:.55;
}
.post-overview p{margin:.6rem 0 .75rem; font-size:1.02rem; line-height:1.6;}
@media (min-width:768px){.post-overview p{font-size:1.12rem;}}
/* Avoid styling the date paragraph */
article.prose > p.text-muted{background:none!important;padding:0!important;border:none!important}
/* Stronger subtitles (Markdown #### -> h4) */
article.prose h4{font-weight:800; letter-spacing:.01em; position:relative;}
article.prose h4::after{content:""; position:absolute; left:0; bottom:-.35rem; width:42px; height:3px; background:color-mix(in oklab, currentColor 55%, transparent); border-radius:2px; opacity:.7}
@media (min-width:768px){article.prose h4{font-size:1.13em}}

/* Ensure exactly one separator above Share: remove any trailing hr/divider from content */
article.prose > :is(hr,.divider):last-child{display:none}
/* Remove any divider placed directly before Share wrapper */
.share-wrap > .divider{display:none}
/* Provide a single consistent divider via the Share wrapper */
.share-wrap{margin-top:1rem; padding-top:1rem; position:relative}
.share-wrap::before{content:""; position:absolute; left:0; right:0; top:0; height:1px; background: color-mix(in oklab, currentColor 15%, transparent)}
</style>

<script is:inline>
// Group leading paragraphs before first heading/blockquote/list into overview box
(function(){
  const article = document.querySelector('article.prose');
  if(!article) return;
  const blocks = Array.from(article.children);
  // Find first structural break (heading, blockquote, list, hr, image figure)
  let cutoffIndex = null;
  for(let i=0;i<blocks.length;i++){
    const el = blocks[i];
    if(el.matches('h2,h3,h4,blockquote,ul,ol,hr,.section-icon,figure')){cutoffIndex=i; break;}
  }
  // Collect paragraphs from start until cutoffIndex (excluding title/date already outside article? date inside, so skip date class)
  const overviewParas = [];
  for(const el of blocks){
    if(el === blocks[0]) continue; // skip h1
    if(el.matches('p.text-muted')) continue; // skip date
    if(cutoffIndex!==null && blocks.indexOf(el)>=cutoffIndex) break;
    if(el.tagName === 'P') overviewParas.push(el);
  }
  if(overviewParas.length){
    const wrapper = document.createElement('div');
    wrapper.className='post-overview';
    overviewParas[0].before(wrapper);
    for(const p of overviewParas) wrapper.appendChild(p);
  }
})();
</script>
