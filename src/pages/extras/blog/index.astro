---
import Layout from '../../../components/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts').catch(() => []))
  .filter(p => p.data?.title)
  .sort((a,b) => new Date(b.data.date||0).getTime() - new Date(a.data.date||0).getTime());

const groups: Record<string, typeof posts> = {};
for (const p of posts) {
  const year = p.data.date ? new Date(p.data.date).getFullYear().toString() : 'Other';
  (groups[year] ||= []).push(p);
}
const years = Object.keys(groups).sort((a,b) => b.localeCompare(a));
const title = 'Blog';
const description = 'Guides, announcements & extra ideas.';
---
<Layout title={title} description={description}>
  <header class="mb-8 flex flex-col gap-4 md:flex-row md:items-end md:justify-between tone-green">
    <div>
      <h1 class="font-display text-3xl md:text-4xl mb-2 tone-green-text">{title}</h1>
      <p class="text-muted max-w-prose">{description}</p>
    </div>
    <div class="flex gap-3 items-end">
      <label class="flex flex-col gap-1 text-xs font-medium tracking-wide uppercase text-muted">
        Search
        <span class="relative inline-block">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="pointer-events-none absolute left-2.5 top-1/2 -translate-y-1/2 h-4 w-4 text-muted">
            <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="1.8"/>
            <path d="M20 20l-3.2-3.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
          <input
            id="blog-search"
            type="search"
            placeholder="Search posts..."
            class="w-56 max-w-[70vw] rounded border border-fg/25 bg-fg/5 pl-9 pr-3 py-2 text-sm focus:border-neon outline-none"
            autocomplete="off"
          />
        </span>
      </label>
    </div>
  </header>

  {posts.length === 0 && <p class="text-muted">No posts yet.</p>}

  <div class="divider" aria-hidden="true"></div>

  <div id="blog-results" class="space-y-12">
    {years.map(y => (
      <section data-year={y} class="year-group">
  <h2 class="font-display text-xl md:text-2xl mb-4 tracking-tight flex items-center gap-2 tone-green-text">
          <span>{y}</span>
          <span class="text-[11px] font-normal text-muted bg-fg/10 px-2 py-0.5 rounded">{groups[y].length}</span>
        </h2>
        <ul class="space-y-4 m-0 p-0 list-none">
          {groups[y].map(p => {
            const url = `/extras/blog/${p.slug}/`;
            const dRaw = p.data.date ? new Date(p.data.date) : undefined;
            const d = dRaw ? dRaw.toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' }) : '';
            return (
              <li
                class="group relative glass p-5 transition-colors"
                data-title={(p.data.title || '').toLowerCase()}
                data-excerpt={(p.data.excerpt || '').toLowerCase()}
              >
                <h3 class="text-lg font-semibold mb-1 leading-snug group-hover:text-fg">{p.data.title}</h3>
                {d && <p class="text-[11px] tracking-wide uppercase text-muted mb-2">{d}</p>}
                {p.data.excerpt && <p class="text-sm text-muted leading-relaxed">{p.data.excerpt}</p>}
                <p class="mt-3 text-[11px] font-medium uppercase text-muted group-hover:text-fg">Read →</p>
                <a href={url} aria-label={`Read: ${p.data.title}`} class="absolute inset-0 rounded-md focus-visible:outline-none focus-visible:ring-2">
                  <span class="sr-only">{p.data.title}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </div>

  <p id="blog-empty" class="hidden text-muted italic mt-8">No posts match your search.</p>

  <script is:inline>
    (() => {
      const input = document.getElementById('blog-search');
      const empty = document.getElementById('blog-empty');
  const groups = Array.from(document.querySelectorAll('.year-group'));
      if (!input) return;

      function filter() {
        const q = input.value.trim().toLowerCase();
        let visibleCount = 0;

        groups.forEach(group => {
          const items = group.querySelectorAll('li');
          let anyVisible = false;
          items.forEach(li => {
            const t = li.getAttribute('data-title') || '';
            const e = li.getAttribute('data-excerpt') || '';
            const match = !q || t.includes(q) || e.includes(q);
            li.classList.toggle('hidden', !match);
            if (match) { anyVisible = true; visibleCount++; }
          });
          group.classList.toggle('hidden', !anyVisible);
        });

        empty.classList.toggle('hidden', visibleCount !== 0);
      }

      input.addEventListener('input', filter);
      // On browsers with a built-in search clear (×), an input event will fire after clearing
      // No explicit count here; year group badges still show per-year totals
    })();
  </script>
</Layout>
