---
import Layout from '../../../components/Layout.astro';
import { getCollection } from 'astro:content';
import StructuredData from '../../../components/StructuredData.astro';
import ShareButtons from '../../../components/game/ShareButtons.astro';
import FeedbackCard from '../../../components/game/FeedbackCard.astro';
import BackLink from '../../../components/BackLink.astro';
import { canonical } from '../../../lib/urls';
import { activityLD } from '../../../lib/schema';
import { withBase } from '../../../lib/paths';

export async function getStaticPaths() {
  const activities = await getCollection('activities');
  return activities.map(a => ({ params: { slug: a.slug }, props: { entry: a } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const title = entry.data.title;
const description = entry.data.excerpt || `Activity: ${title}.`;
const difficulty = entry.data.difficulty;
const pageCanonical = canonical(Astro.url.pathname, Astro.site);
const ld = activityLD({ title, description, url: pageCanonical });
---
<Layout title={title} description={description} canonical={pageCanonical}>
  <article class="prose-invert max-w-none tone-green">
    <header class="mb-6">
      <h1 class="font-display text-4xl mb-2 tone-green-text">{title}</h1>
      {description && <p class="text-muted !mt-0 mb-3 max-w-prose">{description}</p>}
      {difficulty && <p class="!mt-0 text-sm text-muted"><strong>Difficulty:</strong> {difficulty}</p>}
    </header>

    <Content />

    <div class="divider" aria-hidden="true"></div>
    <ShareButtons title={title} />
    <FeedbackCard />
  </article>

  <BackLink href={withBase('extras/activities/')} label="Back to Activities" />

  <!-- Add icons before section headings using inline SVGs -->
  <script is:inline>
    (function(){
      // Transform select sections into cards and remove the Overview section
      try {
        const article = document.querySelector('article');
        if (article) {
          const isHeading = (el) => {
            if (!el || !el.tagName) return false;
            const t = el.tagName.toUpperCase();
            return t === 'H2' || t === 'H3' || t === 'H4';
          };

          function findHeadings() {
            return Array.from(article.querySelectorAll('h2, h3, h4'));
          }

          function wrapSection(re) {
            const heading = findHeadings().find(h => re.test((h.textContent || '').trim()));
            if (!heading) return;
            const wrapper = document.createElement('section');
            wrapper.className = 'glass tone-green p-5 md:p-6 rounded-xl border border-fg/15 my-5 card-section';
            heading.parentNode && heading.parentNode.insertBefore(wrapper, heading);
            const level = parseInt(heading.tagName.substring(1), 10) || 2;
            let node = heading;
            while (node) {
              const next = node.nextSibling;
              wrapper.appendChild(node);
              if (next && isHeading(next)) {
                const nextLevel = parseInt((next.tagName || 'H9').substring(1), 10) || 9;
                if (nextLevel <= level) break;
              }
              node = next;
            }
          }

          // Remove Overview/About section entirely (including description until next same/higher heading)
          (function removeOverview(){
            const h = findHeadings().find(h => /(overview|about)/i.test((h.textContent || '').trim()));
            if (!h) return;
            const level = parseInt(h.tagName.substring(1), 10) || 2;
            let node = h;
            while (node) {
              const next = node.nextSibling;
              node.parentNode && node.parentNode.removeChild(node);
              if (next && isHeading(next)) {
                const nl = parseInt((next.tagName || 'H9').substring(1), 10) || 9;
                if (nl <= level) break;
              }
              node = next;
            }
          })();

          // Wrap key sections as cards
          wrapSection(/^(requirements|equipment|items|tools)\b/i);
          wrapSection(/^(how\s*to\b.*|play\b)$/i);
          wrapSection(/^(top\s*tips|tips|advice|hints)\b/i);
        }
      } catch (e) { /* noop */ }

      function svg(name){
        switch(name){
          case 'info': return `<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='9'/><path d='M12 8h.01'/><path d='M12 12v4'/></svg>`;
          case 'tools': return `<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M14.7 6.3a4 4 0 1 0-5.66 5.66l8 8a2 2 0 0 0 2.83-2.83l-8-8Z'/><path d='M5 13l-3 3 3 3 3-3'/><path d='M7 11l-2 2'/></svg>`;
          case 'settings': return `<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z'/><path d='M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06A2 2 0 1 1 7.04 3.3l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06A2 2 0 1 1 20.7 7.04l-.06.06a1.65 1.65 0 0 0-.33 1.82V9c0 .66.26 1.3.73 1.77.47.47 1.11.73 1.77.73H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z'/></svg>`;
          case 'target': return `<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='9'/><circle cx='12' cy='12' r='3'/><path d='M12 3v3M21 12h-3M12 21v-3M3 12h3'/></svg>`;
          case 'howto': return `<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M4 19.5A2.5 2.5 0 0 1 6.5 17H20'/><path d='M20 22H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20Z'/><path d='M8 7h8M8 11h6'/></svg>`;
          case 'rules': return `<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M5 4h14v16H5z'/><path d='M9 8h6M9 12h6M9 16h6'/></svg>`;
          case 'tips': return `<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M9 18h6M10 22h4'/><path d='M2 12h2M20 12h2M12 2v2M4.93 4.93l1.41 1.41M17.66 4.93l-1.41 1.41'/><path d='M12 8a4 4 0 0 1 4 4c0 1.5-.5 2.5-1.5 3.5-.7.7-1 1.5-1 2.5h-3c0-1-.3-1.8-1-2.5C8.5 14.5 8 13.5 8 12a4 4 0 0 1 4-4Z'/></svg>`;
          case 'special': return `<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M12 2 3 7v10l9 5 9-5V7l-9-5Z'/><path d='M12 8v8M8 12h8'/></svg>`;
        }
      }
      const map = [
  { re: /(overview|about)/i, icon: 'info' },
  { re: /(equipment|items|gear|tools|requirements)/i, icon: 'tools' },
        { re: /(setup|prepare|start)/i, icon: 'settings' },
        { re: /(aim|goal|objective|target)/i, icon: 'target' },
        { re: /(how to|play|steps|instructions|method|recipe)/i, icon: 'howto' },
        { re: /(rules?|guidelines|dos|donts)/i, icon: 'rules' },
        { re: /(tips|advice|hints|notes|top tips)/i, icon: 'tips' },
        { re: /(special|variants|edition|extras?)/i, icon: 'special' }
      ];
      function matchIcon(text){
        for (const m of map) if (m.re.test(text)) return m.icon;
        return null;
      }
      document.querySelectorAll('article h2, article h3').forEach(h => {
        if (h.querySelector('.section-icon')) return;
        const icon = matchIcon(h.textContent || '');
        if (!icon) return;
  const span = document.createElement('span');
  span.className = 'section-icon inline-flex w-9 h-9 items-center justify-center rounded-lg bg-fg/5 border border-fg/15 mr-2 align-middle';
  const color = icon === 'special' ? 'text-yellow-400' : 'text-fg/80';
  span.innerHTML = `<span class=\"w-5 h-5 ${color}\" aria-hidden=\"true\">${svg(icon)}</span>`;
        h.prepend(span);
      });
    })();
  </script>

  <StructuredData data={ld} />
</Layout>
