---
import Layout from '../components/Layout.astro';
import { getCollection } from 'astro:content';
import { excludeLegacyNoise } from '../lib/filters';
import { withBase } from '../lib/paths';
import { canonical } from '../lib/urls';
import CardLink from '../components/CardLink.astro';

const games = excludeLegacyNoise(await getCollection('games'));
const recentGames = games.slice(0, 12);

const drinksEntries = excludeLegacyNoise(await getCollection('drinks'));
const popularDrinks = drinksEntries.slice(0, 12);

const posts = excludeLegacyNoise(await getCollection('posts'))
  .filter(p => !p.data.draft)
  .sort((a,b) => (b.data.date || '').localeCompare(a.data.date || ''))
  .slice(0, 6);

const pageCanonical = canonical(Astro.url.pathname, Astro.site);
---
<Layout title="BeerGoggleGames" description="Drinking games, cocktails & shots, forfeits, glossary and wheel tools." canonical={pageCanonical} wide={true}>
  <section slot="banner" class="w-full border-t border-b border-fg/15 bg-fg/5/10">
    <div class="marquee h-9 flex items-center">
      <div class="marquee-track">
        <span>Stacked Cards UI</span>
        <span>Random Game / Drink</span>
        <span>Wheel · Dice · Coin</span>
        <span>New Drinks Weekly</span>
        <span>Search Everything</span>
        <span>Stacked Cards UI</span>
        <span>Random Game / Drink</span>
        <span>Wheel · Dice · Coin</span>
        <span>New Drinks Weekly</span>
        <span>Search Everything</span>
      </div>
    </div>
  </section>

  <!-- Card Stack Hero -->
  <section class="stack-hero rounded-2xl border border-fg/15 mb-10" data-animate="fade-up">
    <div class="stack-wrap">
      <div class="stack-card c1 will-parallax" data-parallax="-0.1"></div>
      <div class="stack-card c2 will-parallax" data-parallax="0.06"></div>
      <div class="stack-card c3 will-parallax" data-parallax="0.12">
        <picture>
          <img
            src={withBase('images/hero.webp')}
            alt="Party tools and games"
            class="w-full h-full object-cover rounded-xl"
            onerror="this.closest('.c3').innerHTML='<div class=&quot;w-full h-full rounded-xl border border-fg/20 bg-fg/5 grid place-items-center text-muted text-xs&quot;>Add hero image (images/hero.webp)</div>'"
            loading="lazy"
            decoding="async"
          />
        </picture>
      </div>
    </div>
    <div class="stack-content">
      <h1 class="title-xl">Party Faster. Play Smarter.</h1>
      <p class="lead">Discover games, drinks and tools with a playful card aesthetic.</p>
      <div class="actions">
        <a href={withBase('games/')} class="pill-btn">Browse Games</a>
        <a href={withBase('extras/wheel-of-fortune/')} class="pill-btn neon">Spin a Wheel →</a>
      </div>
    </div>
  </section>

  <!-- Quick + random -->
  <section class="mb-10" data-animate="fade-up">
    <ul class="grid gap-5 md:grid-cols-3 list-none p-0 m-0">
      {[
        { label: 'Random Game', href: withBase('games/random'), desc: 'Let fate decide your next play.' },
        { label: 'Random Drink', href: withBase('drinks/random'), desc: 'Jump to a surprise drink recipe.' },
        { label: 'All Extras', href: withBase('extras/'), desc: 'Wheel, forfeits, glossary, dice & coin.' }
      ].map(i => (
        <li class="group">
          <a href={i.href} class="card-mini">
            <div class="dot"></div>
            <div class="mini-body">
              <div class="mini-title">{i.label}</div>
              <div class="mini-desc">{i.desc}</div>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Games carousel -->
  <section class="mb-12" data-animate="fade-up">
    <header class="head">
      <h2 class="h2">Latest Games</h2>
      <div class="ctrls">
        <button class="ctrl" data-target="#games-carousel" data-dir="-1" aria-label="Previous">‹</button>
        <button class="ctrl" data-target="#games-carousel" data-dir="1" aria-label="Next">›</button>
      </div>
    </header>
    <div id="games-carousel" class="rail">
      {recentGames.map(g => {
        const slug = (g.slug ?? g.id).split('/').pop();
        const href = withBase(`games/${slug}/`);
        const img = withBase(`images/${slug}.webp`);
        return (
          <a class="tile" href={href} aria-label={`View game: ${g.data.title}`}>
            <picture><img src={img} alt={g.data.title} class="tile-img" loading="lazy" decoding="async" onerror="this.style.display='none'"/></picture>
            <div class="tile-caption">{g.data.title}</div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- Drinks carousel -->
  <section class="mb-12" data-animate="fade-up">
    <header class="head">
      <h2 class="h2">Popular Drinks</h2>
      <div class="ctrls">
        <button class="ctrl" data-target="#drinks-carousel" data-dir="-1" aria-label="Previous">‹</button>
        <button class="ctrl" data-target="#drinks-carousel" data-dir="1" aria-label="Next">›</button>
      </div>
    </header>
    <div id="drinks-carousel" class="rail">
      {popularDrinks.map(d => {
        const slug = (d.slug ?? d.id).split('/').pop();
        const href = withBase(`drinks/${slug}/`);
        const img = withBase(`images/${slug}.webp`);
        return (
          <a class="tile" href={href} aria-label={`View drink: ${d.data.title}`}>
            <picture><img src={img} alt={d.data.title} class="tile-img" loading="lazy" decoding="async" onerror="this.style.display='none'"/></picture>
            <div class="tile-caption">{d.data.title}</div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- Blog -->
  {posts.length > 0 && (
    <section class="mb-16" data-animate="fade-up">
      <header class="head">
        <h2 class="h2">From the Blog</h2>
        <a href={withBase('extras/blog/')} class="all">All Posts</a>
      </header>
      <div id="blog-carousel" class="rail">
        {posts.map(p => {
          const slug = (p.slug ?? p.id).split('/').pop();
          const href = withBase(`extras/blog/${slug}/`);
          return (
            <a class="tile" href={href} aria-label={`Read post: ${p.data.title}`}>
              <div class="tile-img placeholder">Add image</div>
              <div class="tile-caption">{p.data.title}</div>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <style>
    .marquee { overflow:hidden; position:relative; }
    .marquee-track { display:inline-flex; gap:2.4rem; padding-inline:1.2rem; min-width:220vw; animation:marquee 24s linear infinite; }
    .marquee:hover .marquee-track { animation-play-state: paused; }
    @keyframes marquee { from{transform:translateX(0)} to{transform:translateX(-50%)} }

    /* Stack hero */
    .stack-hero { position:relative; background: radial-gradient(1200px 500px at 20% 0%, rgba(255,0,128,0.10), transparent 60%), radial-gradient(900px 600px at 100% 100%, rgba(0,200,255,0.10), transparent 60%); }
    .stack-wrap { position:relative; height: clamp(220px, 28vw, 320px); margin: 18px; }
    .stack-card { position:absolute; inset:0; border-radius:1rem; border:1px solid rgba(255,255,255,0.12); background: rgba(255,255,255,0.03); transform-origin: center; }
    .c1 { transform: translate(-12px,-10px) rotate(-4deg); }
    .c2 { transform: translate(10px,6px) rotate(3deg); }
    .c3 { overflow:hidden; border:1px solid rgba(255,255,255,0.18); }
    .stack-content { padding: 0 18px 18px 18px; }
    .title-xl { font-family: var(--font-display, inherit); font-size: clamp(1.9rem, 2.4vw + 1rem, 2.8rem); letter-spacing:-.01em; margin-bottom:.4rem; }
    .lead { color:var(--muted, #bfbfbf); margin-bottom:.6rem; }
    .actions { display:flex; gap:.6rem; flex-wrap:wrap; }
    .pill-btn { display:inline-flex; align-items:center; gap:.5rem; padding:.6rem 1rem; border-radius:9999px; border:1px solid rgba(255,255,255,0.18); background: rgba(255,255,255,0.03); font-weight:700; font-size:.9rem; }
    .pill-btn:hover { border-color: rgba(255,0,128,0.45); color: var(--neon, #ff0080); }
    .pill-btn.neon { border-color: rgba(255,0,128,0.45); background: linear-gradient(180deg, rgba(255,0,128,0.10), rgba(255,0,128,0.04)); color: var(--neon, #ff0080); }

    /* Quick minis */
    .card-mini { display:flex; gap:.6rem; align-items:flex-start; padding:14px; border-radius:14px; border:1px solid rgba(255,255,255,0.12); background: rgba(255,255,255,0.03); transition:transform .2s ease, border-color .2s ease; }
    .card-mini:hover { transform: translateY(-1px); border-color: rgba(255,0,128,0.4); }
    .dot { width:10px; height:10px; border-radius:50%; background: var(--neon, #ff0080); margin-top:6px; box-shadow: 0 0 16px rgba(255,0,128,0.45); }
    .mini-title { font-weight:700; }
    .mini-desc { font-size:.78rem; color:var(--muted,#bfbfbf); }

    /* Rails / Tiles */
    .head { display:flex; align-items:center; justify-content:space-between; }
    .h2 { font-family: var(--font-display, inherit); font-size: 1.5rem; letter-spacing:-.01em; }
    .rail { display:grid; grid-auto-flow:column; grid-auto-columns: 75%; gap:14px; overflow-x:auto; scroll-snap-type:x mandatory; -webkit-overflow-scrolling:touch; padding: 6px 2px 8px; }
    @media (min-width: 640px) { .rail { grid-auto-columns: 45%; } }
    @media (min-width: 1024px) { .rail { grid-auto-columns: 28%; } }
    .tile { display:block; position:relative; border-radius:16px; overflow:hidden; border:1px solid rgba(255,255,255,0.14); background: rgba(255,255,255,0.03); scroll-snap-align: start; transition: transform .2s ease, border-color .2s ease; }
    .tile:hover { transform: translateY(-2px); border-color: rgba(255,0,128,0.4); }
    .tile-img { width:100%; aspect-ratio: 16/9; object-fit:cover; display:block; }
    .tile-caption { position:absolute; left:10px; bottom:10px; background: rgba(0,0,0,0.45); border: 1px solid rgba(255,255,255,0.2); backdrop-filter: blur(6px); padding:.3rem .5rem; border-radius: 9999px; font-size:.75rem; }

    /* Reveal */
    [data-animate] { opacity:0; transform: translateY(16px); transition: opacity .6s ease, transform .6s ease; }
    [data-animate].in { opacity:1; transform:none; }
    @media (prefers-reduced-motion: reduce) { .marquee-track { animation:none !important; } [data-animate]{opacity:1; transform:none;} }
  </style>

  <script is:inline>
    (() => {
      // Rail controls
      function nudge(id, dir) { const el = document.querySelector(id); if (!el) return; el.scrollBy({ left: el.clientWidth * 0.8 * (dir||1), behavior:'smooth' }); }
      document.querySelectorAll('.ctrl').forEach(b => b.addEventListener('click', () => nudge(b.getAttribute('data-target'), Number(b.getAttribute('data-dir')))));

      // Reveal
      const reduce = matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver((es)=>es.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target);} }),{threshold:.12});
        document.querySelectorAll('[data-animate]').forEach(el=>io.observe(el));
      } else { document.querySelectorAll('[data-animate]').forEach(el=>el.classList.add('in')); }

      // Parallax for stack cards
      if (!reduce) {
        const onScroll = () => {
          document.querySelectorAll('.will-parallax').forEach(el=>{
            const s = Number(el.getAttribute('data-parallax')||0.1);
            const r = el.getBoundingClientRect();
            const rel = (r.top - (innerHeight/2)) / innerHeight;
            el.style.transform = `translateY(${rel * s * 100}px) ${el.classList.contains('c1') ? 'rotate(-4deg)' : el.classList.contains('c2') ? 'rotate(3deg)' : ''}`;
          });
        };
        onScroll();
        addEventListener('scroll', onScroll, { passive:true });
        addEventListener('resize', onScroll, { passive:true });
      }
    })();
  </script>
</Layout>
