---
import Layout from '../components/Layout.astro';
import { getCollection } from 'astro:content';
import { excludeLegacyNoise } from '../lib/filters';
import { withBase } from '../lib/paths';
import { canonical } from '../lib/urls';
import CardLink from '../components/CardLink.astro';

const games = excludeLegacyNoise(await getCollection('games'));
const recentGames = games.slice(0, 12);

const drinksEntries = excludeLegacyNoise(await getCollection('drinks'));
const popularDrinks = drinksEntries.slice(0, 12);

const posts = excludeLegacyNoise(await getCollection('posts'))
  .filter(p => !p.data.draft)
  .sort((a,b) => (b.data.date || '').localeCompare(a.data.date || ''))
  .slice(0, 6);

const pageCanonical = canonical(Astro.url.pathname, Astro.site);
---
<Layout title="BeerGoggleGames" description="Drinking games, cocktails & shots, forfeits, glossary and wheel tools." canonical={pageCanonical} wide={true}>
  <section slot="banner" class="w-full border-t border-b border-fg/15 bg-fg/5/10">
    <div class="marquee h-9 flex items-center">
      <div class="marquee-track">
        <span>Fresh Games Weekly</span>
        <span>Spin the Wheel →</span>
        <span>Dice & Coin Tools</span>
        <span>Discover New Drinks</span>
        <span>Search Everything</span>
        <span>Fresh Games Weekly</span>
        <span>Spin the Wheel →</span>
        <span>Dice & Coin Tools</span>
        <span>Discover New Drinks</span>
        <span>Search Everything</span>
      </div>
    </div>
  </section>

  <!-- Diagonal Split Hero -->
  <section class="diagonal-hero rounded-2xl overflow-hidden mb-10" data-animate="fade-up">
    <div class="diagonal-bg"></div>
    <div class="diagonal-grid"></div>
    <div class="relative px-4 sm:px-6 py-8 md:py-10 grid md:grid-cols-2 gap-6 items-center">
      <div class="space-y-4">
        <span class="chip">Minimal Rules · Maximum Fun</span>
        <h1 class="title-lg">Party Faster. Play Smarter.</h1>
        <p class="text-muted/95 leading-relaxed">Your hub for drinking games, curated cocktails & shots, creative forfeits and decision helpers.</p>
        <div class="flex flex-wrap gap-3">
          <a href={withBase('games/')} class="btn btn-outline">Browse Games</a>
          <a href={withBase('extras/wheel-of-fortune/')} class="btn btn-neon">Spin a Wheel →</a>
        </div>
      </div>
      <div class="relative">
        <div class="frame will-parallax" data-parallax="0.12">
          <picture>
            <img
              src={withBase('images/hero.webp')}
              alt="Party tools and games"
              class="w-full rounded-xl border border-fg/20 bg-fg/5 object-cover aspect-[16/9]"
              onerror="this.closest('picture').outerHTML='<div class=&quot;aspect-[16/9] rounded-xl border border-fg/20 bg-fg/5 flex items-center justify-center text-muted&quot;><span class=&quot;text-xs&quot;>Add hero image at images/hero.webp</span></div>'"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </div>
      </div>
    </div>
  </section>

  <!-- Feature row -->
  <section class="mb-10 features" data-animate="fade-up">
    <div class="feat glass">
      <div class="feat-icon">🎯</div>
      <div class="feat-body">
        <h3>Quick Picks</h3>
        <p>Random game and drink routes get you playing faster.</p>
      </div>
    </div>
    <div class="feat glass">
      <div class="feat-icon">🧊</div>
      <div class="feat-body">
        <h3>Clean Design</h3>
        <p>Optimized for phones with crisp, legible components.</p>
      </div>
    </div>
    <div class="feat glass">
      <div class="feat-icon">⚙️</div>
      <div class="feat-body">
        <h3>Handy Tools</h3>
        <p>Wheel, dice and coin flip to settle decisions instantly.</p>
      </div>
    </div>
  </section>

  <!-- Games -->
  <section class="mb-12" data-animate="fade-up">
    <header class="head">
      <h2 class="h2">Latest Games</h2>
      <div class="ctrls">
        <button class="ctrl" data-target="#games-carousel" data-dir="-1" aria-label="Previous">‹</button>
        <button class="ctrl" data-target="#games-carousel" data-dir="1" aria-label="Next">›</button>
      </div>
    </header>
    <div id="games-carousel" class="rail">
      {recentGames.map(g => {
        const slug = (g.slug ?? g.id).split('/').pop();
        const href = withBase(`games/${slug}/`);
        const img = withBase(`images/${slug}.webp`);
        return (
          <article class="card glass hover:-translate-y-0.5 transition-transform">
            <picture>
              <img src={img} alt={g.data.title} class="thumb" loading="lazy" decoding="async" onerror="this.style.display='none'" />
            </picture>
            <CardLink href={href} ariaLabel={`View game: ${g.data.title}`} as="div" noPadding anchorClass="p-0">
              <h3 class="card-title">{g.data.title}</h3>
              {g.data.excerpt && <p class="card-excerpt">{g.data.excerpt}</p>}
            </CardLink>
          </article>
        );
      })}
    </div>
  </section>

  <!-- Drinks -->
  <section class="mb-12" data-animate="fade-up">
    <header class="head">
      <h2 class="h2">Popular Drinks</h2>
      <div class="ctrls">
        <button class="ctrl" data-target="#drinks-carousel" data-dir="-1" aria-label="Previous">‹</button>
        <button class="ctrl" data-target="#drinks-carousel" data-dir="1" aria-label="Next">›</button>
      </div>
    </header>
    <div id="drinks-carousel" class="rail">
      {popularDrinks.map(d => {
        const slug = (d.slug ?? d.id).split('/').pop();
        const href = withBase(`drinks/${slug}/`);
        const img = withBase(`images/${slug}.webp`);
        return (
          <article class="card glass hover:-translate-y-0.5 transition-transform">
            <picture>
              <img src={img} alt={d.data.title} class="thumb" loading="lazy" decoding="async" onerror="this.style.display='none'" />
            </picture>
            <CardLink href={href} ariaLabel={`View drink: ${d.data.title}`} as="div" noPadding anchorClass="p-0">
              <h3 class="card-title">{d.data.title}</h3>
              {d.data.excerpt && <p class="card-excerpt">{d.data.excerpt}</p>}
            </CardLink>
          </article>
        );
      })}
    </div>
  </section>

  <!-- Blog -->
  {posts.length > 0 && (
    <section class="mb-16" data-animate="fade-up">
      <header class="head">
        <h2 class="h2">From the Blog</h2>
        <a href={withBase('extras/blog/')} class="all">All Posts</a>
      </header>
      <div id="blog-carousel" class="rail">
        {posts.map(p => {
          const slug = (p.slug ?? p.id).split('/').pop();
          const href = withBase(`extras/blog/${slug}/`);
          return (
            <article class="card glass hover:-translate-y-0.5 transition-transform">
              <div class="thumb placeholder">Add blog image</div>
              <CardLink href={href} ariaLabel={`Read post: ${p.data.title}`} as="div" noPadding anchorClass="p-0">
                <h3 class="card-title">{p.data.title}</h3>
                {p.data.excerpt && <p class="card-excerpt">{p.data.excerpt}</p>}
              </CardLink>
            </article>
          );
        })}
      </div>
    </section>
  )}

  <style>
    .marquee { overflow: hidden; position: relative; }
    .marquee-track { display:inline-flex; gap:2.5rem; padding-inline:1.25rem; min-width:220vw; animation:marquee 24s linear infinite; }
    .marquee:hover .marquee-track { animation-play-state: paused; }
    @keyframes marquee { from{transform:translateX(0)} to{transform:translateX(-50%)} }

    .diagonal-hero { position:relative; border:1px solid rgba(255,255,255,0.12); background: rgba(255,255,255,0.02); }
    .diagonal-bg { position:absolute; inset:-20% -10% 0 -10%; background:
        linear-gradient(135deg, rgba(255,0,128,0.25), transparent 60%),
        linear-gradient(315deg, rgba(0,200,255,0.22), transparent 60%);
      transform: skewY(-6deg) translateY(-18%);
      filter: blur(10px);
    }
    .diagonal-grid { position:absolute; inset:0; background-image: linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px);
      background-size: 22px 22px; mask: linear-gradient(to bottom, rgba(0,0,0,.3), rgba(0,0,0,0)); pointer-events:none; }

    .chip { display:inline-block; padding:.45rem .8rem; border-radius:9999px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.18); font-size:.72rem; font-weight:600; letter-spacing:.12em; text-transform:uppercase; }
    .title-lg { font-family: var(--font-display, inherit); font-size: clamp(1.7rem, 2vw + 1rem, 2.4rem); letter-spacing:-.01em; }

    .btn { display:inline-flex; align-items:center; gap:.6rem; padding:.6rem 1rem; border-radius:.75rem; font-weight:600; font-size:.9rem; }
    .btn-outline { border:1px solid rgba(255,255,255,0.18); background: rgba(255,255,255,0.02); }
    .btn-outline:hover { border-color: rgba(255,0,128,0.45); color: var(--neon, #ff0080); }
    .btn-neon { border:1px solid rgba(255,0,128,0.45); background: linear-gradient(180deg, rgba(255,0,128,0.10), rgba(255,0,128,0.04)); color: var(--neon, #ff0080); }

    .frame { border-radius: 1rem; position:relative; }
    .frame::before { content:''; position:absolute; inset:-1px; border-radius:1rem; padding:1px; background: linear-gradient(135deg, rgba(255,0,128,0.45), rgba(0,200,255,0.45));
      -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; pointer-events:none; }

    .features { display:grid; gap:12px; grid-template-columns: repeat(1,minmax(0,1fr)); }
    @media (min-width: 768px){ .features { grid-template-columns: repeat(3,minmax(0,1fr)); } }
    .glass { background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.02)); border:1px solid rgba(255,255,255,0.12); border-radius:14px; padding:16px; }
    .feat { display:flex; gap:12px; align-items:flex-start; }
    .feat-icon { width:36px; height:36px; display:grid; place-items:center; border-radius:50%; background: rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.18); }
    .feat-body h3 { font-weight:700; margin:0 0 2px 0; }
    .feat-body p { margin:0; font-size:.9rem; color:var(--muted, #bfbfbf); }

    .head { display:flex; align-items:center; justify-content:space-between; }
    .h2 { font-family: var(--font-display, inherit); font-size: 1.5rem; letter-spacing:-.01em; }
    .all { font-size:.75rem; text-transform:uppercase; letter-spacing:.12em; text-decoration:underline; text-underline-offset:4px; color:var(--neon, #ff0080); }

    .rail { display:grid; grid-auto-flow:column; grid-auto-columns: 80%; gap:14px; overflow-x:auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; padding-bottom:6px; }
    @media (min-width: 640px) { .rail { grid-auto-columns: 45%; } }
    @media (min-width: 1024px) { .rail { grid-auto-columns: 30%; } }
    .card { padding:12px; border-radius:14px; }
    .thumb { width:100%; aspect-ratio:16/9; object-fit:cover; border-radius:10px; border:1px solid rgba(255,255,255,0.2); background: rgba(255,255,255,0.06); margin-bottom:8px; }
    .placeholder { display:flex; align-items:center; justify-content:center; color:var(--muted,#bfbfbf); }
    .card-title { font-weight:700; }
    .card-excerpt { font-size:.75rem; color:var(--muted,#bfbfbf); margin-top:2px; }
    .ctrls { display:flex; gap:8px; }
    .ctrl { border:1px solid rgba(255,255,255,0.2); padding:.3rem .6rem; border-radius:.5rem; font-size:.85rem; background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.02)); }
    .ctrl:hover { border-color: rgba(255,0,128,0.45); color: var(--neon, #ff0080); }

    [data-animate] { opacity:0; transform: translateY(16px); transition: opacity .6s ease, transform .6s ease; }
    [data-animate].in { opacity:1; transform:none; }
    @media (prefers-reduced-motion: reduce) { .marquee-track { animation: none !important; } [data-animate]{opacity:1; transform:none;} }
  </style>

  <script is:inline>
    (() => {
      // Rail scroll
      function nudge(id, dir) { const el = document.querySelector(id); if (!el) return; el.scrollBy({ left: el.clientWidth * 0.8 * (dir||1), behavior:'smooth' }); }
      document.querySelectorAll('.ctrl').forEach(b => b.addEventListener('click', () => nudge(b.getAttribute('data-target'), Number(b.getAttribute('data-dir')))));

      // Reveal
      const reduce = matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver((es)=>es.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target);} }),{threshold:.12});
        document.querySelectorAll('[data-animate]').forEach(el=>io.observe(el));
      } else { document.querySelectorAll('[data-animate]').forEach(el=>el.classList.add('in')); }

      // Parallax
      if (!reduce) {
        const onScroll = () => {
          document.querySelectorAll('.will-parallax').forEach(el=>{
            const s = Number(el.getAttribute('data-parallax')||0.1);
            const r = el.getBoundingClientRect();
            const rel = (r.top - (innerHeight/2)) / innerHeight;
            el.style.transform = `translateY(${rel * s * 100}px)`;
          });
        };
        onScroll();
        addEventListener('scroll', onScroll, { passive:true });
        addEventListener('resize', onScroll, { passive:true });
      }
    })();
  </script>
</Layout>
