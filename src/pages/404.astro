---
import Layout from '../components/Layout.astro';
import { withBase } from '../lib/paths';
---
<Layout title="Not Found" description="The page you’re looking for doesn’t exist.">
  <h1 class="font-display text-3xl md:text-4xl mb-2">404</h1>
  <p class="text-muted">We couldn't find that page.</p>

  <div class="divider" aria-hidden="true"></div>

  <p><a class="hover:text-neon underline underline-offset-4" href={withBase('')}>← Back to Home</a></p>
</Layout>
