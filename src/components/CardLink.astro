---
/**
 * Reusable clickable card component with glassy style.
 *
 * Props:
 *  - href: string (required)
 *  - ariaLabel?: string
 *  - overlay?: boolean (default false)
 *  - as?: string (default 'li')
 *  - class?: string (outer wrapper)
 *  - anchorClass?: string (anchor extra classes)
 *  - noPadding?: boolean
 *  - tone?: 'cyan' | 'magenta' | 'green' (optional tint)
 */
interface Props {
  href: string;
  ariaLabel?: string;
  overlay?: boolean;
  as?: string;
  class?: string;
  anchorClass?: string;
  noPadding?: boolean;
  tone?: 'cyan' | 'magenta' | 'green';
}

const {
  href,
  ariaLabel,
  overlay = false,
  as = 'li',
  class: outerExtra = '',
  anchorClass = '',
  noPadding = false,
  tone
} = Astro.props as Props;

const Tag = as as keyof HTMLElementTagNameMap;

const baseOuter = 'group relative list-none p-0 m-0';
const toneClass = tone === 'cyan' ? 'tone-cyan' : tone === 'magenta' ? 'tone-magenta' : tone === 'green' ? 'tone-green' : '';
const baseCard =
  `glass ${toneClass} flex flex-col h-full rounded-sm transition ` +
  (noPadding ? '' : 'p-4 ');
const baseOverlayWrapper =
  `glass ${toneClass} flex flex-col h-full rounded-sm transition ` +
  (noPadding ? '' : 'p-4 ');
const overlayAnchorBase =
  'absolute inset-0 z-10 rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neon/60';
---
<Tag class={`${baseOuter} ${outerExtra}`.trim()}>
  {overlay ? (
    <>
      <div class={`${baseOverlayWrapper} relative z-20`}>
        <slot />
      </div>
      <a
        href={href}
        class={`${overlayAnchorBase} ${anchorClass}`.trim()}
        aria-label={ariaLabel}
      >
        {ariaLabel && <span class="sr-only">{ariaLabel}</span>}
      </a>
    </>
  ) : (
    <a
      href={href}
      class={`${baseCard} ${anchorClass}`.trim()}
      aria-label={ariaLabel}
    >
      <slot />
    </a>
  )}
</Tag>
