---
import '../styles.css';
import { withBase, base } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  wide?: boolean;
  fullBleed?: boolean;
  noindex?: boolean;
  image?: string;
}

const {
  title = 'Beer Goggle Games',
  description = 'Drinking games, cocktails, party activities & more.',
  canonical,
  ogImage,
  wide = false,
  fullBleed = false,
  noindex = false,
  image,
} = Astro.props as Props;

const current = Astro.url.pathname;

function isActive(segment: string) {
  if (segment === '') {
    const cur = current.endsWith('/') ? current : current + '/';
    const root = withBase('');
    const rootNorm = root.endsWith('/') ? root : root + '/';
    return cur === rootNorm;
  }
  const norm = segment.endsWith('/') ? segment : segment + '/';
  return current.startsWith(withBase(norm));
}

type IconName = 'home' | 'games' | 'drinks' | 'extras' | 'search';

function icon(name: IconName, size = 18) {
  const baseSvg = `width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
    stroke-linecap="round" stroke-linejoin="round"`;
  switch (name) {
    case 'home':
      return `<svg ${baseSvg}><path d="M3 11.5 12 3l9 8.5M5 10v10h14V10"/></svg>`;
    case 'games':
      return `<svg ${baseSvg}><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="9" cy="9" r="1.5"/><circle cx="15" cy="15" r="1.5"/></svg>`;
    case 'drinks':
      return `<svg ${baseSvg}><path d="M3 4h18l-8.5 8.5v5.5l3 2H8l3-2v-5.5L3 4Z"/><path d="M10 4l4 4"/></svg>`;
    case 'extras':
      return `<svg ${baseSvg}><path d="M12 3v4M12 17v4M7.05 7.05l2.83 2.83M14.12 14.12l2.83 2.83M3 12h4M17 12h4M7.05 16.95l2.83-2.83M14.12 9.88l2.83-2.83"/></svg>`;
    case 'search':
      return `<svg ${baseSvg}><circle cx="11" cy="11" r="7"/><path d="m21 21-4.35-4.35"/></svg>`;
  }
}

interface NavLink {
  href: string;
  label: string;
  key: string;
  icon: IconName;
}

const navLinks: NavLink[] = [
  { href: withBase(''), label: 'Home', key: '', icon: 'home' },
  { href: withBase('games/'), label: 'Games', key: 'games', icon: 'games' },
  { href: withBase('drinks/'), label: 'Drinks', key: 'drinks', icon: 'drinks' },
  { href: withBase('extras/'), label: 'Extras', key: 'extras', icon: 'extras' },
  { href: withBase('search'), label: 'Search', key: 'search', icon: 'search' },
];

const mainClass = [
  'grow mx-auto w-full px-4 py-8',
  fullBleed ? '' : wide ? 'max-w-7xl' : 'max-w-6xl',
].join(' ');

const year = new Date().getFullYear();
const siteUrl = canonical || 'https://beergogglegames.co.uk';
const ogImg = image || ogImage;
---

<!doctype html>
<html lang="en" class="bg-bg font-body text-fg" data-base={base}>
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {ogImg && <meta property="og:image" content={withBase(ogImg.replace(/^\/+/, ''))} />}

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Space+Grotesk:wght@600;700&display=swap"
      rel="stylesheet"
    />

    <link
      rel="alternate"
      type="application/rss+xml"
      href={withBase('rss.xml')}
      title="Beer Goggle Games RSS"
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'Beer Goggle Games',
        url: siteUrl,
        sameAs: ['https://github.com/benbarraclough/BeerGoggleGames'],
      })}
    />
  </head>
  <body class="flex min-h-screen flex-col selection:bg-neon/40">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:rounded focus:bg-bg focus:px-4 focus:py-2 focus:text-fg focus:ring-2"
    >
      Skip to content
    </a>

    <header
      class="sticky top-0 z-[1400] border-b border-fg/20 bg-bg/95 backdrop-blur-sm supports-[backdrop-filter]:bg-bg/75"
    >
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-4 py-4">
        <a
          href={withBase()}
          class="whitespace-nowrap font-display text-2xl tracking-tight hover:text-fg"
        >
          BeerGoggleGames
        </a>
        <nav class="hidden flex-wrap items-center gap-5 text-sm lg:flex" aria-label="Primary">
          {
            navLinks.map(l => {
              const active = isActive(l.key);
              return (
                <a
                  href={l.href}
                  class:list={[
                    'flex items-center gap-2 rounded px-2 py-1 transition-colors hover:bg-fg/5 hover:text-fg/90',
                    active && 'bg-fg/10 font-semibold text-fg',
                  ]}
                  aria-current={active ? 'page' : undefined}
                >
                  <span aria-hidden="true" class="inline-block" set:html={icon(l.icon, 18)} />
                  <span>{l.label}</span>
                </a>
              );
            })
          }
        </nav>
        <a
          id="nav-toggle"
          href="#site-menu"
          class="inline-flex items-center gap-2 rounded border border-fg/30 bg-bg/70 px-3 py-2 text-sm backdrop-blur-sm hover:border-fg/50 hover:text-fg lg:hidden"
          aria-controls="site-menu"
          aria-expanded="false"
        >
          <span class="sr-only">Open menu</span>
          <svg width="22" height="18" viewBox="0 0 22 18" fill="none" class="stroke-current">
            <path d="M1 1H21M1 9H21M1 17H21" stroke-width="2" stroke-linecap="round"></path>
          </svg>
          Menu
        </a>
      </div>
      <slot name="banner" />
    </header>

    <div id="site-menu" class="site-menu-overlay" aria-label="Mobile navigation">
      <div class="site-menu-panel">
        <div class="flex items-center justify-between border-b border-fg/25 px-5 py-4">
          <span class="font-display text-xl">Menu</span>
          <a
            href="#"
            id="nav-close"
            class="inline-flex items-center gap-2 rounded border border-fg/30 px-3 py-2 text-sm hover:border-fg/50 hover:text-fg"
            aria-label="Close menu">✕</a
          >
        </div>
        <nav
          class="flex grow flex-col gap-4 overflow-y-auto px-6 py-8 text-lg"
          aria-label="Mobile Primary"
        >
          {
            navLinks.map(l => {
              const active = isActive(l.key);
              return (
                <a
                  href={l.href}
                  class:list={[
                    'flex items-center gap-3 rounded px-2 py-2 hover:text-fg',
                    active && 'bg-fg/10 font-semibold text-fg',
                  ]}
                  aria-current={active ? 'page' : undefined}
                  data-close
                >
                  <span aria-hidden="true" class="inline-block" set:html={icon(l.icon, 22)} />
                  <span>{l.label}</span>
                </a>
              );
            })
          }
          <div
            class="mt-8 max-w-prose border-t border-fg/20 pt-6 text-sm leading-relaxed text-muted"
          >
            <p class="mb-3">Explore drinking games, cocktails, shots, activities & tools.</p>
            <p>
              Try the <a
                class="underline underline-offset-4 hover:text-fg"
                href={withBase('games/random')}>Random Game</a
              > or the <a
                class="underline underline-offset-4 hover:text-fg"
                href={withBase('extras/wheel-of-fortune')}>Wheel</a
              >.
            </p>
          </div>
        </nav>
      </div>
    </div>

    <main id="main" class={mainClass}>
      <slot />
    </main>

    <!-- Footer: more spacing, newsletter tweaks, legal section restored -->
    <footer class="mt-auto border-t border-fg/20">
      <div
        class="mx-auto grid max-w-7xl gap-8 px-8 py-8 text-sm sm:grid-cols-2 sm:gap-10 lg:grid-cols-4 lg:px-12"
      >
        <div class="space-y-4">
          <h2 class="text-xs font-semibold uppercase tracking-wide text-fg/80">Explore</h2>
          <ul class="grid grid-cols-2 gap-x-4 gap-y-1 md:block md:space-y-1">
            <li><a class="hover:text-fg" href={withBase('games/')}>Games</a></li>
            <li><a class="hover:text-fg" href={withBase('drinks/')}>Drinks</a></li>
            <li><a class="hover:text-fg" href={withBase('extras/')}>Extras</a></li>
            <li><a class="hover:text-fg" href={withBase('about')}>About</a></li>
            <li><a class="hover:text-fg" href={withBase('contact')}>Contact</a></li>
            <li><a class="hover:text-fg" href={withBase('search')}>Search</a></li>
          </ul>
        </div>

        <div class="space-y-4">
          <h2 class="text-xs font-semibold uppercase tracking-wide text-fg/80">Resources</h2>
          <ul class="grid grid-cols-2 gap-x-3 gap-y-1 md:block md:space-y-1">
            <li><a class="hover:text-fg" href={withBase('rss.xml')}>RSS</a></li>
            <li><a class="hover:text-fg" href={withBase('sitemap.xml')}>Sitemap</a></li>
          </ul>
        </div>

        <div class="space-y-4">
          <h2 class="text-xs font-semibold uppercase tracking-wide text-fg/80">Newsletter</h2>
          <form
            action="https://buttondown.email/api/emails/embed-subscribe/beergogglegames"
            method="post"
            target="_blank"
            class="mt-2 space-y-2"
            data-newsletter
          >
            <div class="flex gap-2">
              <input
                id="nl-email"
                name="email"
                type="email"
                required
                placeholder="you@example.com"
                class="w-full rounded border border-fg/20 bg-fg/5 px-3 py-2 text-xs focus:border-fg/60 focus:outline-none"
                autocomplete="email"
              />
              <button
                type="submit"
                class="rounded border border-fg/20 bg-fg/10 px-3 py-2 text-xs hover:border-fg/60 hover:text-fg"
              >
                Join
              </button>
            </div>
            <p class="text-[10px] leading-relaxed text-muted/70">No spam. Unsubscribe anytime.</p>
          </form>
        </div>

        <div class="space-y-4">
          <h2 class="text-xs font-semibold uppercase tracking-wide text-fg/80">Legal</h2>
          <p class="leading-relaxed text-muted">
            © {year} Beer Goggle Games. All rights reserved.
          </p>
          <p class="text-[11px] leading-relaxed text-muted/80">
            Drink responsibly. Only participate if you are of legal drinking age in your location.
            Stay hydrated & look after friends.
          </p>
        </div>
      </div>

      <div class="border-t border-fg/15">
        <div
          class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-3 px-8 py-4 text-[11px] text-muted sm:flex-row lg:px-12"
        >
          <div class="flex flex-wrap items-center gap-4">
            <span>© {year} Beer Goggle Games</span>
          </div>
          <button id="back-to-top" class="underline underline-offset-4 hover:text-fg"
            >Back to top</button
          >
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        const toggle = document.getElementById('nav-toggle');
        if (!toggle) return;
        function sync() {
          toggle.setAttribute('aria-expanded', location.hash === '#site-menu' ? 'true' : 'false');
        }
        window.addEventListener('hashchange', sync);
        sync();
        document.querySelectorAll('#site-menu [data-close]').forEach(a =>
          a.addEventListener('click', () => {
            history.replaceState(null, '', location.pathname + location.search);
            sync();
          }),
        );
      })();
    </script>
    <script is:inline>
      (function () {
        const topBtn = document.getElementById('back-to-top');
        if (topBtn)
          topBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
      })();
    </script>
  </body>
</html>
