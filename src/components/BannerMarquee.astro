---
interface Props {
  text: string;
  speed?: number; // seconds for one full loop
}
const { text, speed = 40 } = Astro.props as Props;
---
<div class="banner-marquee" role="marquee" aria-label={text}>
  <div class="banner-track" style={`--speed:${speed}s`}>
    <span class="banner-item">{text}</span>
    <span class="banner-item">{text}</span>
    <span class="banner-item">{text}</span>
  </div>
</div>

<style>
.banner-marquee{overflow:hidden;position:relative;height:100%;display:flex;align-items:center}
.banner-track{display:inline-flex;gap:2.5rem;white-space:nowrap;will-change:transform;transform:translateX(100%);animation:banner-slide var(--speed,40s) linear infinite;animation-delay: calc(var(--speed,40s) * -0.25)}
@keyframes banner-slide{0%{transform:translateX(100%)}100%{transform:translateX(-100%)}}
@media (prefers-reduced-motion:reduce){.banner-track{animation:none;transform:none}}
.banner-item{display:inline-block}

/* Add separators between repeated items for visual spacing */
.banner-item + .banner-item::before{content:"•"; opacity:.6; margin:0 .9rem}

/* Mobile: use same slower speed; negative delay above ensures early appearance */
</style>
