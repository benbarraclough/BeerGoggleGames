---
interface Props {
  text: string;
  /** seconds for one full loop on desktop */
  speed?: number;
  /** seconds for one full loop on mobile */
  speedMobile?: number;
  /** pause animation on hover (desktop) */
  pauseOnHover?: boolean;
  /** show subtle edge fades */
  edgeFade?: boolean;
}
const {
  text,
  // Faster defaults: desktop faster than mobile
  speed = 14,
  speedMobile = 18,
  pauseOnHover = true,
  edgeFade = true,
} = Astro.props as Props;
---
<div class:list={["banner-marquee", edgeFade && "banner-fade"]} role="marquee" aria-label={text} style={`--speed:${speed}s; --speed-sm:${speedMobile}s; --hover-ps:${pauseOnHover ? 'paused' : 'running'}`}>
  <div class="banner-track">
    <span class="banner-item">{text}</span>
  </div>
</div>

<style>
.banner-marquee{overflow:hidden;position:relative;height:100%;display:flex;align-items:center}
/* Optional edge fade for nicer entrance/exit */
.banner-fade{ -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }

.banner-track{display:inline-flex;gap:2.5rem;white-space:nowrap;will-change:transform;transform:translateX(100%);animation-name:banner-slide;animation-timing-function:linear;animation-iteration-count:infinite;animation-duration: var(--speed, 40s)}
/* Mobile: slightly slower */
@media (max-width: 640px){
  .banner-track{animation-duration: var(--speed-sm, var(--speed, 40s));}
}
/* Base: start a bit off-screen to avoid appearing centered */
@keyframes banner-slide{0%{transform:translateX(105%)}100%{transform:translateX(-105%)}}
/* Desktop/wide: start even further right so entry always comes from edge */
@media (min-width: 641px){
  .banner-track{animation-name: banner-slide-wide}
}
@keyframes banner-slide-wide{0%{transform:translateX(120%)}100%{transform:translateX(-120%)}}
@media (prefers-reduced-motion:reduce){.banner-track{animation:none;transform:none}}
.banner-item{display:inline-block}

/* Pause on hover (desktop only) */
@media (hover:hover){
  :where(.banner-marquee):hover .banner-track{animation-play-state: var(--hover-ps, paused)}
}

/* Mobile: use same slower speed; negative delay above ensures early appearance */
</style>
