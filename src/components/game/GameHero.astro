---
import { withBase } from '../../lib/paths';
const { cover, alt = '' } = Astro.props;
function normalizeCover(c: string): string {
  if (!c) return '';
  // Keep absolute URLs as-is
  if (/^https?:\/\//i.test(c)) return c;
  let s = String(c).trim();
  // Collapse any subfolder like images/games/ to images/
  s = s.replace(/^\/?images\/games\//, 'images/');
  // Ensure we have an images/ prefix
  if (/^\/?images\//.test(s)) {
    s = s.replace(/^\//, '');
  } else {
    s = 'images/' + s.replace(/^\//, '');
  }
  return s;
}
const src = normalizeCover(cover);
---

<figure class="relative mb-8 aspect-[16/7] overflow-hidden rounded-xl border border-fg/20">
  <img
    src={withBase(src)}
    alt={alt}
    class="hero-img saturate-110 h-full w-full object-cover brightness-90 transition-transform duration-700"
    loading="lazy"
    decoding="async"
    onerror="window.__imgFallback && window.__imgFallback(this)"
  />
  <div
    class="pointer-events-none absolute inset-0 bg-gradient-to-tr from-bg/80 via-bg/20 to-transparent"
  >
  </div>
</figure>

<style>
  @media (hover: hover) {
    .hero-img:hover {
      transform: scale(1.05);
    }
  }
</style>

<script is:inline>
  (function () {
    if (window.__imgFallback) return;
    function uniq(arr) {
      return Array.from(new Set(arr));
    }
    function baseName(url) {
      try {
        url = String(url);
      } catch {
        return '';
      }
      const m = url.match(/([^\/]+)\.webp$/i);
      return m ? m[1] : '';
    }
    function makeCandidates(name) {
      const out = [];
      const original = name;
      const noHyphen = name.replace(/-/g, '');
      const andToAmp = name.replace(/-and-/g, '&').replace(/-/g, '');
      const removeOf = name.replace(/-of-/g, '-');
      const ofNoHyphen = removeOf.replace(/-/g, '');
      const m = name.match(/^(\d+-\d+)-(.*)$/); // 7-11-doubles -> 7-11doubles
      const numericJoin = m ? m[1] + m[2].replace(/-/g, '') : '';
      [original, noHyphen, andToAmp, ofNoHyphen, numericJoin]
        .filter(Boolean)
        .forEach(n => out.push(n + '.webp'));
      return uniq(out);
    }
    window.__imgFallback = function (img) {
      try {
        if (!(img instanceof HTMLImageElement)) return;
        const cur = img.getAttribute('src') || '';
        const currentName = baseName(cur);
        const key = img.getAttribute('data-fb-key') || currentName;
        const list = (img.__fbList = img.__fbList || makeCandidates(key));
        let i = img.__fbIndex || 0;
        // Skip current
        while (i < list.length && cur.includes('/' + list[i])) i++;
        if (i >= list.length) {
          img.style.display = 'none';
          return;
        }
        img.__fbIndex = i + 1;
        const next = list[i];
        const prefix = (cur.split('/images/')[0] || '').replace(/\/$/, '');
        img.src = prefix + '/images/' + next;
      } catch {}
    };
  })();
</script>
