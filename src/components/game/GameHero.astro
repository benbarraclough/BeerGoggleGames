---
import { withBase } from '../../lib/paths';
const { cover, alt = '' } = Astro.props;
function normalizeCover(c: string): string {
  if (!c) return '';
  // Keep absolute URLs as-is
  if (/^https?:\/\//i.test(c)) return c;
  let s = String(c).trim();
  // Collapse any subfolder like images/games/ to images/
  s = s.replace(/^\/?images\/games\//, 'images/');
  // Ensure we have an images/ prefix
  if (/^\/?images\//.test(s)) {
    s = s.replace(/^\//, '');
  } else {
    s = 'images/' + s.replace(/^\//, '');
  }
  return s;
}
const src = normalizeCover(cover);
---

<figure class="relative mb-8 aspect-[16/7] overflow-hidden rounded-xl border border-fg/20">
  <img
    src={withBase(src)}
    alt={alt}
    class="hero-img saturate-110 h-full w-full object-cover brightness-90 transition-transform duration-700"
    loading="lazy"
    decoding="async"
    onerror="window.__imgFallback && window.__imgFallback(this)"
  />
  <div
    class="pointer-events-none absolute inset-0 bg-gradient-to-tr from-bg/80 via-bg/20 to-transparent"
  >
  </div>
</figure>

<style>
  @media (hover: hover) {
    .hero-img:hover {
      transform: scale(1.05);
    }
  }
</style>
