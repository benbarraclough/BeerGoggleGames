---
import SharedShare from '../ShareButtons.astro';
const { title, url, withDivider } = Astro.props;
---
<SharedShare title={title} url={url} withDivider={withDivider} />
---
const { title } = Astro.props;
const site = Astro.site ?? 'https://example.com';
const builtPath = Astro.url.pathname.replace(/index\.html?$/,'');
const sharePageUrl = new URL(builtPath, site).toString();

const encodedUrl = encodeURIComponent(sharePageUrl);
const encodedTitle = encodeURIComponent(title ?? '');

interface ShareLink { name: string; url: string; icon: string; className?: string; label?: string; }
const shareLinks: ShareLink[] = [
  { name: 'Facebook', url: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`, icon: 'facebook', className: 'share--facebook', label: 'Share on Facebook' },
  { name: 'X',        url: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`, icon: 'x',        className: 'share--x',        label: 'Share on X' },
  { name: 'Reddit',   url: `https://www.reddit.com/submit?url=${encodedUrl}&title=${encodedTitle}`,   icon: 'reddit',   className: 'share--reddit',   label: 'Share on Reddit' },
  { name: 'WhatsApp', url: `https://api.whatsapp.com/send?text=${encodeURIComponent(`${title ?? ''} ${sharePageUrl}`)}`, icon: 'whatsapp', className: 'share--whatsapp', label: 'Share on WhatsApp' }
];

function svg(name: string) {
  switch (name) {
    case 'facebook': return '<path d="M13 3h3V0h-3c-3.31 0-6 2.69-6 6v3H4v3h3v7h3v-7h3l1-3h-4V6c0-1.103.897-2 2-2Z"/>';
    case 'x':        return '<path d="M3 3h4.6l5.1 6.9L17.2 3H21l-6.9 9.3L21 21h-4.6l-5.3-7.2L6.8 21H3l7-9.7L3 3Z"/>';
    case 'reddit':   return '<path d="M22 11.5c0-1.652-1.348-3-3-3a2.99 2.99 0 0 0-2.273 1.027c-1.281-.59-2.847-.967-4.527-1.027l1.457-4.563 3.156.75a2.501 2.501 0 1 0 .156-1.004l-3.781-.898a.501.501 0 0 0-.598.34l-1.664 5.211c-1.711.047-3.289.426-4.594 1.023A2.99 2.99 0 0 0 5 8.5c-1.652 0-3 1.348-3 3 0 1.089.594 2.041 1.477 2.562-.02.184-.031.371-.031.562 0 3.033 3.582 5.5 8 5.5s8-2.467 8-5.5c0-.191-.011-.379-.031-.562A2.994 2.994 0 0 0 22 11.5Z"/>';
    case 'whatsapp': return '<path d="M12.04 2c-5.52 0-10 4.42-10 9.86 0 1.74.48 3.42 1.4 4.9L2 22l5.37-1.38c1.42.78 3.02 1.2 4.67 1.2 5.52 0 10-4.42 10-9.86S17.56 2 12.04 2Z"/>';
    case 'copy':     return '<path d="M8 2.5A2.5 2.5 0 0 1 10.5 0h5A2.5 2.5 0 0 1 18 2.5V4h1.25A2.75 2.75 0 0 1 22 6.75v11.5A2.75 2.75 0 0 1 19.25 21H8.75A2.75 2.75 0 0 1 6 18.25V17H4.75A2.75 2.75 0 0 1 2 14.25v-9.5A2.75 2.75 0 0 1 4.75 2h3.3c-.02.16-.05.33-.05.5ZM10.5 2A.5.5 0 0 0 10 2.5V4h6V2.5a.5.5 0 0 0-.5-.5h-5Z"/><path d="M8 6.75A1.75 1.75 0 0 1 9.75 5h9.5A1.75 1.75 0 0 1 21 6.75v11.5A1.75 1.75 0 0 1 19.25 20h-9.5A1.75 1.75 0 0 1 8 18.25Z"/>';
  }
  return '';
}
---
<section class="mt-8 text-center">
  <h4 class="font-semibold mb-3 mt-0 text-sm tracking-wide uppercase text-muted">Share This Page</h4>

  <div class="inline-flex flex-wrap gap-3 justify-center">
    {shareLinks.map(link => (
      <a
        href={link.url}
        target="_blank"
        rel="noopener noreferrer"
        class:list={[
          'group inline-flex items-center gap-2 px-3 py-2 rounded-lg border border-fg/15 bg-bg/40 hover:bg-fg/10 text-xs font-medium transition focus-visible:outline-none focus-visible:ring-2',
          link.className ?? ''
        ]}
        aria-label={link.label ?? link.name}
      >
        <span class="w-4 h-4 block" set:html={`<svg viewBox='0 0 24 24' fill='currentColor' class='w-4 h-4'>${svg(link.icon)}</svg>`}></span>
        <span>{link.name}</span>
      </a>
    ))}

    <button
      type="button"
      class="group inline-flex items-center gap-2 px-3 py-2 rounded-lg border border-fg/15 bg-bg/40 hover:bg-fg/10 text-xs font-medium transition relative focus-visible:outline-none focus-visible:ring-2 text-fg"
      data-copy-button
      aria-label="Copy page URL to clipboard"
    >
      <span class="w-4 h-4 block copy-icon" set:html={`<svg viewBox='0 0 24 24' fill='currentColor' class='w-4 h-4 transition-transform duration-300 group-data-[copied=true]:scale-110'>${svg('copy')}</svg>`}></span>
      <span class="copy-label transition-opacity duration-200 group-data-[copied=true]:opacity-0">Copy</span>
      <span class="copy-feedback pointer-events-none absolute -bottom-5 left-1/2 -translate-x-1/2 text-[10px] opacity-0 group-data-[copied=true]:opacity-100 transition" aria-live="polite">Copied!</span>
      <span class="pointer-events-none absolute inset-0 rounded-lg ring-0 group-data-[copied=true]:ring-2 transition-all duration-300"></span>
    </button>
  </div>
</section>

<script is:inline>
(function(){
  const btn = document.querySelector('[data-copy-button]');
  if(!btn) return;
  const PAGE_URL = window.location.href.split('#')[0];
  function fallbackCopy(text){
    const ta = document.createElement('textarea');
    ta.value = text; ta.style.position='fixed'; ta.style.top='-2000px';
    document.body.appendChild(ta); ta.select();
    try { document.execCommand('copy'); } catch(_) {}
    document.body.removeChild(ta);
  }
  function copy(text){
    if (navigator.clipboard?.writeText) {
      return navigator.clipboard.writeText(text).catch(()=>fallbackCopy(text));
    }
    fallbackCopy(text); return Promise.resolve();
  }
  let timer;
  btn.addEventListener('click', e => {
    e.preventDefault();
    copy(PAGE_URL).then(()=>{
      if (navigator.vibrate) { try { navigator.vibrate(10); } catch(_){} }
      btn.dataset.copied = 'true';
      if (timer) clearTimeout(timer);
      timer = setTimeout(()=>{ delete btn.dataset.copied; }, 1600);
    });
  });
})();
</script>
