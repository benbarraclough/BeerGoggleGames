---
import SharedShare from '../ShareButtons.astro';
const { title, url, withDivider } = Astro.props;
---
<SharedShare title={title} url={url} withDivider={withDivider} />
<script>
  function initCopyButton() {
    const btn = document.querySelector('[data-copy-button]');
    if (!btn) return;
    
    const PAGE_URL = window.location.href.split('#')[0];
    
    function copy(text) {
      if (navigator.clipboard?.writeText) {
        return navigator.clipboard.writeText(text).catch(() => {
          window.prompt('Copy this URL:', text);
        });
      }
      window.prompt('Copy this URL:', text);
      return Promise.resolve();
    }
    
    let timer;
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      copy(PAGE_URL).then(() => {
        if (navigator.vibrate) {
          try {
            navigator.vibrate(10);
          } catch {}
        }
        btn.dataset.copied = 'true';
        if (timer) clearTimeout(timer);
        timer = setTimeout(() => {
          delete btn.dataset.copied;
        }, 1600);
      });
    });
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCopyButton);
  } else {
    initCopyButton();
  }
  
  document.addEventListener('astro:after-swap', initCopyButton);
</script>
