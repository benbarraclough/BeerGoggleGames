---
const { title, icon } = Astro.props;
---
<section class="mb-8 glass p-5">
  <h3 class="group flex items-center gap-3 text-xl font-semibold mb-3 tracking-tight">
    {icon && (
      <span class="section-icon inline-flex w-10 h-10 items-center justify-center rounded-lg bg-fg/5 border border-fg/15 ring-1 ring-[color:var(--tone,rgba(255,255,255,0.15))] transition">
        <img src={icon} alt="" class="w-6 h-6 object-contain opacity-90" loading="lazy" />
      </span>
    )}
    <span>{title}</span>
  </h3>
  <div class="space-y-4 leading-relaxed">
    <slot />
  </div>
</section>

<style>
  @media (hover: hover) {
    .group:hover .section-icon { box-shadow: 0 0 0 2px rgba(var(--tone-rgb, 255,255,255), 0.35) inset; }
  }
</style>
